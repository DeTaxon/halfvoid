Event := class
{
    id := int
    this := !() -> void
    {
        id = eventfd(0,0)
    }
    Get := !() -> int
    {
        return id
    }

    Emit := !() -> void
    {
        someVal := 1U
        write(id,someVal&,8)
    }
    Wait := !() -> void
    {
        someVal := u64
        read(id,someVal&,8)
    }
    Reset := !() -> void
    {
        assert(false)
    }

    Destroy := virtual !() -> void
    {
        close(id)
    }
}
