
ToInt := !(char^ inp) -> int
{
	return strtol(inp,null,0)
}


ToFloat := !(char^ inp) -> float
{
	return strtod(inp,null)
}


IntToStrArr := !(int value, char^ target, int targetSize) -> int
{
	if value == 0
	{
		target[0] = '0'
		target[1] = 0
		return 1
	}else if value == (-2147483647) - 1 {
		// Write("-2147483648",11) TODO
	}else{
		tmp := char[32]

		isNegative := value < 0
		if isNegative
			value = -value
		i := 31
		while value != 0
		{
			remd := value mod 10
			value = value div 10
			tmp[i] = '0' + remd
			i -= 1
		}
		if isNegative
		{
			tmp[i] = '-'
			i -= 1
		}

		i += 1

		result = 31 - i

		for j : (32 - i)
		{
			target[j] = tmp[j + i]
		}

	}
}
FloatToStrArr := !(double value,char^ target, int targetSize) -> int
{
	return sprintf(target,"%f",value)
}
