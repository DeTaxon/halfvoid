

internalDynamicArrayStruct := class
{
	Size := int
	Capacity := int
	Pointer := void^
	IsBorrowedPtr := bool
}

internalBuildBorrowDynamicArray := !(@T^ ptr,int size, internalDynamicArrayStruct buf = #Var) -> T[]
{
	result&->{void^^}^ = buf&
	buf.Size = size
	buf.Capacity = 0
	buf.Pointer = ptr
	buf.IsBorrowedPtr = true
}
internalBuildEmptyDynamicArray := !(internalDynamicArrayStruct buf = #Var) .{@T} -> T[]
{
	result&->{void^^}^ = buf&
	buf.Size = 0
	buf.Capacity = 0
	buf.Pointer = null
	buf.IsBorrowedPtr = false
}

internalDynamicArrayGetElement := !(@T[] ptr,int index) -> ref T
{
	asPtr := ptr&->{internalDynamicArrayStruct^^}^
	assert(asPtr != null)

	assert(index >= 0)
	assert(index < asPtr.Size)

	result = asPtr.Pointer->{T^}[index]&
}
internalDynamicArrayCheckExistance := !(@T[]^ arr) -> T[]
{
	ptr := arr->{internalDynamicArrayStruct^^}
	if ptr^ == null
		ptr^ = new internalDynamicArrayStruct
	
	return arr^
}
internalDynamicArrayAddElement := !(@T[] arr) -> ref T
{
	a := arr&->{internalDynamicArrayStruct^^}^
	assert(a != null)

	if a.Capacity == 0
	{
		alc := GetAllocator()

		newSize := max(a.Size*2,16)
		newPtr := alc.AllocMem(T->TypeSize*newSize)->{T^}
		if T->TypeGroup == "Class"
			for i : newSize
				internalHVInitClass(newPtr[i])
		if a.Pointer != null
			for i : a.Size
				newPtr->{T^}[i] = a.Pointer->{T^}[i]

		if a.Pointer != null and not a.IsBorrowedPtr
			alc.FreeMem(a.Pointer)

		a.Capacity = newSize - a.Size
		a.Pointer = newPtr
		a.IsBorrowedPtr = false
	}

	a.Capacity -= 1
	a.Size += 1

	return a.Pointer->{T^}[a.Size - 1]
}

Size := !(@T[] this) -> int
{
	ptr := this&->{internalDynamicArrayStruct^^}^
	if ptr == null
		return 0
	return ptr.Size
}
GetPointer := !(@T[] this) -> T^
{
	ptr := this&->{internalDynamicArrayStruct^^}^
	if ptr == null
		return null
	return ptr.Pointer->{T^}
}
