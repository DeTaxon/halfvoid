THatchCounter := class
{
	counter := int
	subHatch := THatch

	Inc := !() -> void
	{
		counter += 1
	}
	Dec := !() -> void
	{
		counter -= 1
		if counter == 0
			subHatch.Emit()
	}
	WaitZero := !() -> void
	{
		if counter != 0
			subHatch.Await()
	}
}

THatch := class
{
	flag := bool
	next_wakeup := TITaskPausePoint^

	IsEmitted := !() -> bool
	{
		return flag
	}
	Emit := virtual !() -> void
	{

		if flag
			return void

		TaskCheckMutex.Lock()
		defer TaskCheckMutex.Unlock()
		
		EmitInner()
	}
	EmitInner := virtual !() -> void
	{
		if flag
			return void

		if #Var("HVBenchmark")
		{
			curTask := CurrentTask

			itr := next_wakeup
			while itr != null
			{
				bench := bmCreateTaskEntry(true,1)
				bench.action = "HatchEmits"
				bench.callerTaskId = curTask.taskId
				bench.targetTaskId = itr.itTask

				itr = itr.next_point
			}
		}

		flag = true
		itr := next_wakeup
		while itr != null
		{
			itr.itTask.resume()
			itr.itTask = null
			itr = itr.next_point
		}
		next_wakeup = null
	}
	GetWaitingCount := virtual !() -> int
	{
		counter := 0
		itr := next_wakeup
		while itr != null
		{
			counter += 1
			itr = itr.next_point
		}
		return counter
	}
	Reset := virtual !() -> void
	{
		if not flag
			return void

		TaskCheckMutex.Lock()
		defer TaskCheckMutex.Unlock()

		if not flag
			return void

		flag = false
		next_wakeup = null
	}

	Await := virtual !() -> void
	{
		if flag
			return void

		TaskCheckMutex.Lock()
		defer TaskCheckMutex.Unlock()

		if flag
			return void

		curTask := CurrentTask

		if #Var("HVBenchmark")
		{
			bench := bmCreateTaskEntry(true,1)
			bench.action = "HatchLock"
			bench.callerTaskId = curTask.taskId
		}

		pt := TITaskPausePoint
		pt.next_point = next_wakeup
		pt.itTask = curTask
		next_wakeup = pt&
		assert(pt.itTask != null)

		CurrentThread.switchToMain()

		if #Var("HVBenchmark")
		{
			bench := bmCreateTaskEntry(false)
			bench.action = "HatchUnlock"
			bench.callerTaskId = curTask.taskId
		}

	}
}

TITaskPausePoint := class
{
	itTask := Task^	
	next_point := TITaskPausePoint^
}

TaskGetHatchWork := !() -> TaskData^
{
	if pausePoint == null
		return null
	retVal := pausePoint.itTask
	pausePoint = pausePoint.next_point
	return retVal
}

