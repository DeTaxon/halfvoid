

IN_CLOSE := 24
IN_OPEN := 32
IN_MODIFY := 2
IN_CREATE := 0x100


wd_struct := class
{
	wd := s32
	mask := u32
	cookie := u32

	len := u32
	name := char[1]
}


//TODO
//Check for repeats
FIONREAD := 21531
inotify_wrapper_fd := class
{
	event := Event
	fd := int

	nodesMutex := Mutex
	fileNodes := AVLMap.{int,inotify_wrapper_node}
	monitorThread := Thread^

	Init := !() -> void
	{
	}

	MonitorFolder := !(int^ resID, Str folderPath,bool recursive,!(FSObject^,FSChangeEvent)& -> void cb) -> void
	{
		@once {
			event."this"()
			nodesMutex."this"()
			this.fd = inotify_init1(2048)
			
			monitorThread = new Thread(() ==> {
				pollList := pollfd[2]

				pollList[0].fd = event.Get()
				pollList[0].events = POLLIN

				pollList[1].fd = iw_fd.fd
				pollList[1].events = POLLIN

				buf := char[4096]

				while not iw_fd_quit
				{
					pollList[1].revents = 0
					poll(pollList&,2,1000)

					if (pollList[0].revents and_b POLLIN) != 0
						return void
					if (pollList[1].revents and_b POLLIN) == 0
						continue

					redBytes := read(pollList[1].fd,buf[0]&,4096)

					ptr := buf[0]&->{wd_struct^}
					fileName := StringSpan(ptr.name[0]&)

					nodesMutex.Lock()
					defer nodesMutex.Unlock()


					node := ref iw_fd.fileNodes[ptr.wd]
					sBuf := TEchoStream

					if node.objectName != "."
					{
						sBuf << node.objectName
						if node.objectName[node.objectName.Size() - 1] != '/'
							sBuf << "/"
					}
					sBuf << fileName

					fullPath := sBuf.GetStr()

					newFile := new File()
					newFile.localPath = fullPath
					newFile.objName->AsString = fileName.GetString()

					TaskCheckMutex.Lock()
					if node.nodeWork.isPaused
					{
						node.nodeWork.monitorTask.resume()
						node.nodeWork.isPaused = false
					}
					mask := FSChangeEvent
					mask = "Created"
					if (ptr.mask and_b IN_MODIFY) != 0
						mask = "Changed"
					node.nodeWork.changedObjects.Emplace(newFile,mask)
					TaskCheckMutex.Unlock()
				}
			})
		}


		thisMask := IN_MODIFY + IN_CREATE

		thisWork := NodeWork
		thisWork.monitorTask = CurrentTask

		nodesMutex.Lock()

		wd := inotify_add_watch(this.fd,folderPath.GetString().Str(),thisMask)
		resID?^ = wd
		newNode := ref fileNodes[wd]
		newNode.objectName->AsString = folderPath.GetString()
		newNode.nodeWork = thisWork&

		if recursive
		{
			FSReadFolder(folderPath,true, (x) ==> {
				if x is not in Folder
					return void
				absPath := fsGetAbsolutePath(x.GetPath())
				wd := inotify_add_watch(this.fd,absPath.GetOr("").Str(),thisMask)
				resID?^ = wd
				newNode := ref fileNodes[wd]
				newNode.objectName = x.GetPath()
				newNode.nodeWork = thisWork&
			})
		}

		nodesMutex.Unlock()

		thrd := CurrentThread
		//TODO Cancalable
		while not thisWork.isCanceled
		{
			TaskCheckMutex.Lock()
			thisWork.isPaused = true
			thrd.switchToMain()
			TaskCheckMutex.Unlock()


			//TODO also move content to temporary object
			if thisWork.changedObjects.Size() != 0
			{
				for it : thisWork.changedObjects
				{
					cb(it.0,it.1)
				}
				thisWork.changedObjects.Destroy()
			}
		}
	}
	Stop := !(int id) -> void
	{
		nodesMutex.Lock()
		defer nodesMutex.Unlock()

		if not fileNodes.Contain(id)
			return void

		node := ref fileNodes[id]

		node.nodeWork.isCanceled = true
		node.nodeWork.monitorTask.resume()
		node.nodeWork.isPaused = false

		fileNodes.Remove(id)
	}
}
inotify_wrapper_node := class
{
	objectName := Str
	nodeWork := NodeWork^
}

NodeWork := class
{
	monitorTask := Task^
	changedObjects := List.{Tuple.{FSObject^,FSChangeEvent}}
	isPaused := bool
	isCanceled := bool
}

iw_fd := inotify_wrapper_fd
iw_fd_quit := false
//TODO add destroy
initMonitorFolder := !() -> void
{
	iw_fd.Init()
}
stopMonitorFolder := !() -> void
{
	if iw_fd.monitorThread != null
	{
		iw_fd_quit = true
		iw_fd.event.Emit()
		iw_fd.monitorThread.Join()
	}

}


AsyncMonitorFolderNonStop := !(int^ resID,Str folderPath,bool recursive,!(FSObject^,FSChangeEvent)& -> void cb) -> void
	#Mark("JITPass")
{
	#MarkFunction("CallAtStart",initMonitorFolder)
	#MarkFunction("CallAtEnd",stopMonitorFolder)

	iw_fd.MonitorFolder(resID,folderPath,recursive,cb)
}
AsyncMonitorFolderStop := !(int resID) -> void
	#Mark("JITPass")
{
	iw_fd.Stop(resID)
}
