AppendClass ImContext
{
	DrawInt := !(vec2f pos,int value) -> void
	{
		intVal := char[32]
		IntToStrArr(value,intVal[0]&,32)
		DrawText(pos,intVal[0]&)
	}
	DrawFloat := !(vec2f pos,double value) -> void
	{
		val := char[32]
		FloatToStrArr2(value,val[0]&,32)
		DrawText(pos,val[0]&)
	}

	DrawFloatEdit := !(vec2f pos,float^ toEdit,bool EditByMouse = true) -> vec2f
	{

		if mouseFirstPress
		{
			posEnd := pos + vec2f(120,22)

			if mousePos.x >= pos.x and mousePos.x <= posEnd.x
				and mousePos.y >= pos.y and mousePos.y <= posEnd.y
			{
				selectedObject = toEdit
				FloatToStrArr2(toEdit^,numberEdit[0]&,numberEdit.Size())
			}
		}

		if selectedObject == toEdit
		{
			if DrawTextEdit(pos,numberEdit,toEdit) == "quit"
				toEdit^ = strtod(numberEdit[0]&,null) //TODO something needed for safe converting
		}else{
			val := char[32]
			FloatToStrArr2(toEdit^,val[0]&,32)

			dotIndx := -1

			i := 0
			while val[i] != 0
			{
				if val[i] == '.'
				{
					dotIndx = i
					break
				}
				i += 1
			}
			assert(dotIndx != -1)

			expDotPos := 4
			expSize := 8

			fils := 0
			if dotIndx < expDotPos
				fils = expDotPos - dotIndx

			chWidth := 10

			chPos := pos + vec2f(chWidth*fils,22)

			i = 0
			while val[i] != 0
			{
				drawChar(chPos.x,chPos.y,val[i])
				chPos.x += chWidth
				i += 1
			}
			textSize := vec2f(chWidth*expSize,22)

			endP := pos + textSize

			if EditByMouse
				and mousePos.x > pos.x and mousePos.x < endP.x
				and mousePos.y > pos.y and mousePos.y < endP.y
			{

				indx := 0
				stp := pos.x

				i := 0
				while true
				{
					cSize := chWidth
					if mousePos.x < stp + cSize
						break
					stp += cSize
					i += 1
				}
				values := ![1000.0,100.0,10.0,1.0,1.0,0.1,0.01,0.001,0.0001]

				val := 0.0
				if i < values.Size()
					val = values[i]

				added := deltaMouseWheel.y*val

				toEdit^ += added

				DrawFloat(mousePos + vec2f(0,20),i)
				DrawFloat(mousePos + vec2f(0,40),values.Size())
				DrawFloat(mousePos + vec2f(0,60),val)
				DrawFloat(mousePos + vec2f(0,80),stp)
			}
		}
	}
	editNumberBox := !(vec2f pos, vec2f size,float[] values) -> float
	{
		endP := pos + size

		if mousePos.x > pos.x and mousePos.x < endP.x
			and mousePos.y > pos.y and mousePos.y < endP.y
		{

			indx := 0
			stp := pos.x

			i := 0
			while true
			{
				cSize := 10
				if mousePos.x < stp + cSize
					break
				stp += cSize
				i += 1
			}

			val := 0.0
			if i < values.Size()
				val = values[i]

			result = deltaMouseWheel.y*val

			DrawFloat(mousePos + vec2f(0,20),i)
			DrawFloat(mousePos + vec2f(0,40),values.Size())
			DrawFloat(mousePos + vec2f(0,60),val)
			DrawFloat(mousePos + vec2f(0,80),stp)
		}
	}
}
