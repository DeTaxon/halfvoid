AppendClass ImContext
{
	DrawCentfEdit := !(vec2f pos,centf^ toEdit) -> void
	{
		txtSize := DrawText(pos,"Ang: ")

		angAdders := float[]
		angAdders = ![20.0,10.0,5.0,1.0,0.5,0.1,0.05,0.01]

		p := pos
		p.x += txtSize.x + 10
		for i,j : 0..3
		{
			val := toEdit->{float^}[i]&
			ps := p+vec2f(120*j,0)
			DrawFloatEdit(ps,val,false)
			delta := editNumberBox(ps,vec2f(100,22),angAdders)

			if delta != 0 and i < 3
			{
				rad := delta * 1deg // deg to radians
				vc := vec3f
				vc&->{float^}[i] = 1.0
				moveQ := quantfAt(vc.x,vc.y,vc.z,rad)

				toEdit.ang = toEdit.ang <*> moveQ
			}
		}

		DrawText(pos + vec2f(0,25),"Pos: ")
		for i,j : 4..7
			DrawFloatEdit(p+vec2f(120*j,25),toEdit->{float^}[i]&)
	}
}
