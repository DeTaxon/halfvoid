
JsonNode2 := class
{
	this := !(int setType) -> void { itType = setType }

	haveName := bool
	itType := u8
	itKey := String
	itValue := String
	itSub := List.{JsonNode2^}
	
	Key := !() -> Str { result->AsString = itKey& }
	Value := !() -> Str { result->AsString = itValue& }

	IsField := !() -> bool { return itType == jsonTypeField}
	IsRecord := !() -> bool { return itType == jsonTypeRecord}
	IsArray := !() -> bool { return itType == jsonTypeArray}

	"[]" := !(Str walkPath) -> JsonNode2^
	{
		itms := HybridQueue.{StringSpan,20}
		walkPath.DivideStr(" ",x ==> { itms.Push(x)}) 
		iter  := this&
		for it : itms
		{
			found := false
			for subs : iter.itSub
			{
				if subs.haveName and subs.itKey == it 
				{
					iter = subs
					found = true
					break
				}
			}
			if not found 
				return null
		}
		return iter
	}
	"for" := !() -> jsonNodeIterator2
	{
		result.itNode = this&
	}
	// "for" := #gen !() -> Node^,Str
	// {
	// 	assert(nodes.Simple())
	//
	// 	ptr := nodes.GetPointer()
	//
	// 	for i : nodes.Size()
	// 		return ptr[i].0,ptr[i].1
	// }
}

jsonNodeIterator2 := class
{
	itNode := JsonNode2^
	index := int
	tmp := Str
	HaveValue := !() -> bool
	{
		if itNode == null
			return false
		return index < itNode.itSub.Size()
	}
	"()" := !(Str^& indx) -> JsonNode2^
	{
		result = itNode.itSub[index]
		tmp->AsString = result.itKey&
		indx = tmp&
		index += 1
	}
}


Json2 := class extend JsonNode2
{
	tokens := List.{Tuple.{int,StringSpan}}

	ParseString := !(char^ fileData,int size) -> bool
	{
		jMachine := #Regexp(
			"\"((\\\\ [^]) | [^\"\\\\])*\"",1,
			"[0-9]+(.[0-9]+)?",2,
			"0x[0-9a-fA-F]+([0-9a-fA-F]+)?",2,
			" true | false | null",3,
			"\\{ | \\} | \\, | \\: | \\[ | \\]",4,
			"\\ | \\t | \\n",5
		)

		jMachine.RegExpReadText(StringSpan(fileData,size), (tok,c) ==>
		{
			if c == 5
				return void
			tokens.Emplace(c,tok)
		})
		if tokens.Size() == 0 or tokens[0].0 != 4 or tokens[0].1 != "{"
			return false
		tokens.Pop()
		if not checkRecord(this&)
		{
			return false
		}
		itType = jsonTypeRecord

		return true
	}

		
	checkRecord := !(JsonNode2^ toCheck) -> bool
	{
		while tokens.Size() != 0 and not (tokens[0].0 == 4 and tokens[0].1 == "}")
		{
			if tokens[0].0 == 4 and tokens[0].1 == ","
				tokens.Pop()
			nd := checkNode()
			if nd == null
			{
				return false
			}
			toCheck.itSub.Push(nd)
		}
		if tokens.Size() == 0
		{
			return false
			}
		tokens.Pop()
		return true
	}
	checkArray := !(JsonNode2^ toCheck) -> bool
	{
		while tokens.Size() != 0 and not (tokens[0].0 == 4 and tokens[0].1 == "]")
		{
			if tokens[0].0 == 4 and tokens[0].1 == ","
				tokens.Pop()
			newNode := checkNode2(new JsonNode2)
			toCheck.itSub.Push(newNode)
		}
		if tokens.Size() == 0
			return false
		tokens.Pop()
		return true
	}
	checkNode := !() -> JsonNode2^
	{
		thisNode := new JsonNode2

		if tokens.Size() == 0 or tokens[0].0 != 1
			return null
		keySpan := tokens[0].1[1..-1]
		thisNode.itKey.Borrow(keySpan.NonNullStr(),keySpan.Size())
		thisNode.haveName = true
		tokens.Pop()

		if tokens.Size() == 0 or tokens[0].0 != 4 or tokens[0].1 != ":" 
			return null
		tokens.Pop()
		if tokens.Size() == 0
			return null
		return checkNode2(thisNode)
	}
	checkNode2 := !(JsonNode2^ thisNode) -> JsonNode2^
	{
		//switch tokens[0].0
		//{
		if tokens[0].0 == 1 or tokens[0].0 == 2 or tokens[0].0 == 3
		{
		//case in ![1,2,3]
			thisNode.itType = jsonTypeField
			if tokens[0].0 == 1
			{
				spn := tokens[0].1[1..-1]
				thisNode.itValue.Borrow(spn.NonNullStr(),spn.Size())
			}
			else
			{
				spn := tokens[0].1
				thisNode.itValue.Borrow(spn.NonNullStr(),spn.Size())
			}
			
			tokens.Pop()
		}else if tokens[0].0 == 4
		{
		//case 4
			switch tokens[0].1
			{
			case "["
				thisNode.itType = jsonTypeArray
				tokens.Pop()
				if not checkArray(thisNode)
					return null
			case "{"
				thisNode.itType = jsonTypeRecord
				tokens.Pop()
				if not checkRecord(thisNode)
					return null
			}
		}
		return thisNode
	}
}
