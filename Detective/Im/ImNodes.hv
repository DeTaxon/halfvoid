
ImNode := class
{
	pos := vec2f
	size := vec2f
	color := vec4f
}

ImNodePair := class
{
	source := int
	target := int
	subNode1 := u16
	subNode2 := u16
}

ImNodeData := class
{
	arrowsCount := int
	arrows := ImNodePair[5]
}

AppendClass ImContext
{
	offst := vec2f
	curZoom := float

	nodeColors := vec4f[16]

	InitNodes := !() -> void
	{
		curZoom = 1.0
		nodeColors[^] = vec4f(RandFloat(0,1),RandFloat(0,1),RandFloat(0,1),1.0)
	}
	DrawNodes := !() -> void
	{
		shaderDataNode.ApplyShaderToQueue(vk,cmds.Get(),width,height)

		ptr := bmBigData.GetPointer()->{bmtStackFrameInfo^}
		blkSize := vec2f(200,200)

 
		linesCount := 0
		xOffset := float
		line := bmtStackFrameInfo^[1024]
		busy := bool[1024]

		delta := 1.0
		zoomDelta := delta*1.01

		if newButton == 'e'
		{
			curZoom = 1
			offst = vec2f(0)
		}

		if buttons['q'] or buttons['a']
		{
			newZoom := curZoom
			if buttons['q']
				newZoom = newZoom / zoomDelta
			if buttons['a']
				newZoom *= zoomDelta

			// mousePos = x*vec2f(curZoom) + offst
			loc := (mousePos - offst) / vec2f(curZoom)
			offst = mousePos - loc*vec2f(newZoom)

			curZoom = newZoom
		}

		drawScale = vec2f(curZoom,curZoom)

		moveVal := delta*10 / curZoom
		if buttons['L']
			offst.x += moveVal
		if buttons['R']
			offst.x -= moveVal
		if buttons['U']
			offst.y += moveVal
		if buttons['D']
			offst.y -= moveVal

		for i : bmIterator
		{
			nd := ptr[i]&

			inLine := -1

			for j : linesCount
			{
				if line[j]?.callerTaskId == nd.callerTaskId
				{
					inLine = j
					break
				}
			}

			if inLine == -1
			{
				putLine := -1
				for j : linesCount
				{
					if line[j] == null and not busy[j]
					{
						putLine = j
						break
					}
				}
				if putLine == -1 and putLine < line.Size()
					putLine = linesCount++
				if putLine == -1
					continue

				line[putLine] = nd

				inLine = putLine
			}else{
				if busy[inLine]
				{
					xOffset += 240
					busy[^] = false
				}
			}

			if nd.action == "TaskQuit"
				line[inLine] = null

			busy[inLine] = true

			yOffset := inLine*240 + 100

			pos := vec2f(xOffset,yOffset)
			drawOffset = offst

			endPos := (blkSize + pos)*curZoom
			posScaled := pos*curZoom

			// if endPos.x < 0 or endPos.y < 0
			// 	continue
			// if posScaled.x >= width or posScaled.y >= height
			// 	break

			// if selectedObject == nd
			// {
			// 	diff := mousePos - capturedPos
			// 	posX += diff.x
			// 	posY += diff.y
			//
			// 	if not mousePressed
			// 	{
			// 		node.pos += diff
			// 		selectedObject = null
			// 	}
			// }
			//
			// if mouseFirstPress
			// {
			// 	if mousePos.x > posX and mousePos.y > posY
			// 		and mousePos.x < (posX + node.size.x)
			// 		and mousePos.y < (posY + node.size.y)
			// 	{
			// 		capturedPos = mousePos
			// 		selectedObject = node&
			// 	}
			// }

			drawCube(pos,blkSize,nodeColors[nd.callerTaskId mod 16])
			DrawText(pos,nd.action.ToCStr())
			if curZoom >= 0.5
			{
				if curZoom >= 0.4
					DrawInt(pos+vec2f(0,24),nd.callerTaskId)
				DrawInt(pos+vec2f(0,24*2),nd.targetTaskId)


				if nd.count != 0
				{
					stPos := pos+vec2f(0,24*3)
					ps := DrawText(stPos,"StackTrace")

					tPos := stPos*drawScale
					ps = ps*drawScale

					if mousePos.x >= tPos.x and mousePos.x <= (tPos.x + ps.x)
						and mousePos.y >= tPos.y and mousePos.y <= (tPos.y + ps.y)
					{
						oldScale := drawScale
						drawScale = vec2f(0.8)
						dat := mousePos / drawScale

						for i : nd.count
						{
							txt := nd.files[i]
							if txt == null
								txt = "(null)"
							p := dat + vec2f(0,24*i)
							txtSize := DrawText(p,txt)
							DrawInt(p + vec2f(txtSize.x + 5,0),nd.lines[i])
						}

						drawScale = oldScale
					}
				}
			}


			// hSize := vec2f(5,5)

			// for i : 4
			// 	drawCube(cubeGetPos(nodes,j,i,false) - hSize,vec2f(10),vec4f(1.0,0.0,0.0,1.0))
			// for i : 4
			// 	drawCube(cubeGetPos(nodes,j,i,true) - hSize,vec2f(10),vec4f(1.0,0.0,0.0,1.0))

		}

		// for i : data.arrowsCount
		// {
		// 	arr := ref data.arrows[i]
		//
		// 	from := cubeGetPos(nodes,arr.source,arr.subNode1,true)
		// 	to := cubeGetPos(nodes,arr.target,arr.subNode2,false)
		//
		// 	drawLine(from,to)
		// }
	}

	cubeGetPos := !(ImNode[] nodes,int indx,int subPos,bool isRight) -> vec2f
	{
		subSize := vec2f(10,10)

		node := ref nodes[indx]

		pos := node.pos

		if node& == selectedObject
			pos += (mousePos - capturedPos)

		pos.y += (subPos + 1)*subSize.x*2

		if isRight
			pos.x += node.size.x

		return pos
	}
	drawCube := !(vec2f pos,vec2f size,vec4f color) -> void
	{
		pos2 := pos*drawScale + drawOffset

		data := float[8]
		data[0] = size.x*drawScale.x / width
		data[1] = size.y*drawScale.y / height
		data[2] = pos2.x / width
		data[3] = pos2.y / height
		data[4] = color.x
		data[5] = color.y
		data[6] = color.z
		data[7] = color.w

		vk.Funcs.vkCmdPushConstants(cmds.Get(),lightLayout.Get(),VK_SHADER_STAGE_VERTEX_BIT,0,data->TypeSize,data&)
		vk.Funcs.vkCmdDraw(cmds.Get(),4,1,0,0)
	}

	bezierSize := float
	drawLine := !(vec2f from,vec2f to) -> void
	{
		bezierSize = 0.005
		middle := (from + to)*0.5

		drawBezierStart(from)
		drawBezier(from,vec2f(middle.x,from.y),middle)
		drawBezier(middle,vec2f(middle.x,to.y),to)
	}
	drawBezierStart := !(vec2f from) -> void
	{
		dim := vec2f(width,height)
		from = from / dim
		from = (from *vec2f(2.0)) - vec2f(1.0)

		meshData := vertPtr[vertCount]&

		meshData[0].pos = from + vec2f(0.0,bezierSize)
		meshData[0].uv = vec2f(1.0,1.0)
		meshData[1].pos = from - vec2f(0.0,bezierSize)
		meshData[1].uv = vec2f(1.0,1.0)

		vertCount += 2
	}
	drawBezier := !(vec2f from,vec2f middle, vec2f to) -> void
	{
		dim := vec2f(width,height)

		from = from / dim
		to = to / dim
		mdl := middle / dim

		from = (from *vec2f(2.0)) - vec2f(1.0)
		to = (to *vec2f(2.0)) - vec2f(1.0)
		mdl = (mdl *vec2f(2.0)) - vec2f(1.0)

		prev := vec2f
		prevA := vec2f
		prevB := vec2f

		for i : 32
		{
			anti := vec2f(i / 31)
			proc := vec2f(1.0 - anti.x)

			pos1 := from * proc + mdl*anti
			pos2 := mdl*proc + to*anti
			pos := pos1*proc + pos2*anti


			if i != 0
			{
				normal := vec2f

				diff := pos - prev
				len := diff.Length()

				if len > 0.0001
				{
					diff = diff*(1 / len)
					normal.x = -diff.y
					normal.y = diff.x
				}

				normal = normal*bezierSize

				meshData := vertPtr[vertCount]&

				meshData[0].pos = pos + normal
				meshData[0].uv = vec2f(1.0,1.0)
				meshData[1].pos = pos - normal
				meshData[1].uv = vec2f(1.0,1.0)

				indxs := indPtr[indCount]&

				offst := vertCount - 2

				indxs[0] = offst
				indxs[1] = offst + 1
				indxs[2] = offst + 2

				indxs[3] = offst + 2
				indxs[4] = offst + 3
				indxs[5] = offst + 1

				vertCount += 2
				indCount += 6

			}

			prev = pos
		}


	}
}

