AppendClass ImContext
{
	//inputes
	mousePressed := bool
	mouseFirstPress := bool
	mousePos := vec2f

	mousePrev := bool

	oldButtons := bool[256]
	newButton := int

	Inputs := !(bool mouse1,vec2f inMousePos) -> void
	{
		mousePrev = mousePressed
		mousePressed = mouse1
		mousePos = inMousePos

		mouseFirstPress = mousePressed and not mousePrev

		newButton = 0
		for i : 256
		{
			if oldButtons[i] != buttons[i]
			{
				if buttons[i]
					newButton = i
				oldButtons[i] = buttons[i]
			}
		}
	}
}
