AppendClass ImContext
{
	DrawText := !(vec2f pos,char^ text) -> vec2f
	{
		pos += vec2f(0,22)

		xPos := pos.x
		yPos := pos.y

		i := 0
		while text[i] != 0
		{

			if selectedObject == text
			{
				if i == textEditPosition
				{
					drawCube(vec2f(xPos,yPos - 22),vec2f(10,22 + 5),vec4f(0,0,1,1))
				}
			}

			xPos += drawChar(xPos,yPos,text[i])

			i += 1
		}
		if selectedObject == text
		{
			if i == textEditPosition
			{
				drawCube(vec2f(xPos,yPos - 22),vec2f(10,22 + 5),vec4f(0,0,1,1))
			}
		}

		return vec2f(xPos - pos.x,22)
	}
	drawChar := !(float xPos,float yPos,int ch) -> float
	{
		xPos = xPos / width
		yPos = yPos / height

		gl := chars[ch]&

		meshData := vertPtr[vertCount]&

		meshData[0].uv.x = gl.x1 / 512 
		meshData[1].uv.x = gl.x1 / 512 
		meshData[2].uv.x = gl.x0 / 512 
		meshData[3].uv.x = gl.x0 / 512 

		meshData[0].uv.y = gl.y1 / 512 
		meshData[1].uv.y = gl.y0 / 512 
		meshData[2].uv.y = gl.y0 / 512 
		meshData[3].uv.y = gl.y1 / 512 

		xSize := (gl.xoff2 - gl.xoff) / width
		ySize := (gl.yoff2 - gl.yoff) / height

		j := 0


		nowX := xPos + gl.xoff / width
		nowY := yPos + gl.yoff / height

		for tx : ![false,false,true,true] , ty : ![false,true,true,false]
		{
			wrt := ref meshData[j++]

			if tx 
			{	
				wrt.pos.x = nowX
			}else{
				wrt.pos.x = nowX + xSize
			}
			if ty 
			{
				wrt.pos.y = nowY
			}else{ 
				wrt.pos.y = nowY + ySize
			}
			wrt.pos = wrt.pos*drawScale + drawOffset/vec2f(width,height) // TODO optimize, precompute as much as possible
			wrt.pos = wrt.pos*vec2f(2.0) - vec2f(1.0)
		}

		indxs := indPtr[indCount]&

		offst := vertCount

		indxs[0] = offst
		indxs[1] = offst + 1
		indxs[2] = offst + 2

		indxs[3] = offst 
		indxs[4] = offst  + 2
		indxs[5] = offst  + 3

		vertCount += 4
		indCount += 6

		return gl.xadvance
	}
}
