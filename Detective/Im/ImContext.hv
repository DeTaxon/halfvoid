ImContext := class
{
	vk := VulkanDefaultInstance^

	lightRenderPass := TRenderPass^

	lightLayout := TShaderInput^
	textedLayout := TShaderInput^
	meshLayout := TShaderInput^

	shaderDataNode := vShader^
	shaderText := vShader^
	shaderMesh := vShader^

	stageVertMem := TVkMemBuffer^
	stageIndMem := TVkMemBuffer^
	gpuVertMem := TVkMemBuffer^
	gpuIndMem := TVkMemBuffer^

	// draw data
	cmds := TVkCommandBuffer^
	width := float
	height := float

	drawScale := vec2f

	vertPtr := MeshData^
	indPtr := int^
	vertCount := int
	indCount := int

	// selected
	selectedObject := void^
	textEditPosition := int
	capturedPos := vec2f

	Init := !(VulkanDefaultInstance^ inst,VKResourceManager^ resMngr) -> void
	{
		vk = inst
	
		lightRenderPass = resMngr.CreateRenderPass(![
			TRenderPassFrame(vk.SwapImageFormat,	VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_PRESENT_SRC_KHR),
		],false)

		empty := TShaderInputVertexInfo	
		lightLayout = lightRenderPass.CreateLayout(empty,![],![
			new TVertexPushConstant(32)
		],
		1,
		topology = "TriangleFan"
		)
		
		textedLayout = lightRenderPass.CreateLayout(empty,![
			new TImageSet(1)
		],![
			new TVertexPushConstant(32)
		],
		1,
		topology = "TriangleFan"
		)

		meshLayout = lightRenderPass.CreateLayout(MeshData,![
			new TImageSet(1)
		],![
			new TVertexPushConstant(32)
		],
		1,
		topology = "Triangles"
		)
	
		shaderDataNode = lightLayout.CreateShader( #EmbedVulkanShader("local:Square.vert"),#EmbedVulkanShader("local:Square.frag"))
		shaderText = textedLayout.CreateShader( #EmbedVulkanShader("local:Texture.vert"),#EmbedVulkanShader("local:Texture.frag"))
		shaderMesh = meshLayout.CreateShader( #EmbedVulkanShader("local:DrawMesh.vert"),#EmbedVulkanShader("local:DrawMesh.frag"))


		temp := 8*1024*1024
		stageVertMem = vk.CreateTransferMemBuffer(temp)
		stageIndMem = vk.CreateTransferMemBuffer(temp)
		gpuVertMem = vk.CreateMemBufferObject(temp,VK_BUFFER_USAGE_VERTEX_BUFFER_BIT or_b VK_BUFFER_USAGE_TRANSFER_DST_BIT)
		gpuIndMem = vk.CreateMemBufferObject(temp,VK_BUFFER_USAGE_INDEX_BUFFER_BIT or_b VK_BUFFER_USAGE_TRANSFER_DST_BIT)
	}

	DrawStart := !(float w, float h,TVkCommandBuffer^ inCmds,VkImageView target ) -> void
	{
		cmds = inCmds
		width = w
		height = h
		drawScale = vec2f(1.0,1.0)

		clrValues := vec4f(0.0,0.3,0.3,1.0)

		atm := VkRenderingAttachmentInfo()
		atm.imageView = target
		atm.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
		atm.resolveMode = VK_RESOLVE_MODE_NONE //TODO
		atm.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR
		atm.storeOp = VK_ATTACHMENT_STORE_OP_STORE
		memcpy(atm.clearValue&,clrValues&,4*4)

		rndr := VkRenderingInfo()
		rndr.renderArea.extent.width = w //surfAb.currentExtent.width
		rndr.renderArea.extent.height = h //surfAb.currentExtent.height
		rndr.layerCount = 1
		rndr.colorAttachmentCount = 1
		rndr.pColorAttachments&->{void^^}^ = atm&

		vk.Funcs.vkCmdBeginRendering(cmds.Get(),rndr&)

		vertPtr = stageVertMem.Map()->{MeshData^}
		indPtr = stageIndMem.Map()->{int^}

		vertCount = 0
		indCount = 0
	}
	DrawEnd := !() -> void
	{
		stageVertMem.Unmap()
		stageIndMem.Unmap()

		vk.PushTransferQueueAndWait(cmd ==> {
			cpyCmd := VkBufferCopy
			cpyCmd.size = vertCount*MeshData->TypeSize
			
			vk.Funcs.vkCmdCopyBuffer(cmd.Get(),stageVertMem.itBuffer,gpuVertMem.itBuffer,1,cpyCmd&)
			memBar := VkBufferMemoryBarrier()
			memBar.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT
			memBar.dstAccessMask = VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT
			memBar.srcQueueFamilyIndex = 0
			memBar.srcQueueFamilyIndex = not_b memBar.srcQueueFamilyIndex
			memBar.dstQueueFamilyIndex = memBar.srcQueueFamilyIndex
			memBar.buffer = gpuVertMem.itBuffer
			memBar.size = cpyCmd.size

			vk.Funcs.vkCmdPipelineBarrier(cmd.Get(),VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_VERTEX_INPUT_BIT,0,0,null,1,memBar&,0,null)
		})
		vk.PushTransferQueueAndWait(cmd ==> {
			cpyCmd := VkBufferCopy
			cpyCmd.size = indCount*4
			
			vk.Funcs.vkCmdCopyBuffer(cmd.Get(),stageIndMem.itBuffer,gpuIndMem.itBuffer,1,cpyCmd&)
			memBar := VkBufferMemoryBarrier()
			memBar.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT
			memBar.dstAccessMask = VK_ACCESS_VERTEX_ATTRIBUTE_READ_BIT
			memBar.srcQueueFamilyIndex = 0
			memBar.srcQueueFamilyIndex = not_b memBar.srcQueueFamilyIndex
			memBar.dstQueueFamilyIndex = memBar.srcQueueFamilyIndex
			memBar.buffer = gpuVertMem.itBuffer
			memBar.size = cpyCmd.size

			vk.Funcs.vkCmdPipelineBarrier(cmd.Get(),VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_VERTEX_INPUT_BIT,0,0,null,1,memBar&,0,null)
		})

		shaderMesh.ApplyShaderToQueue(vk,cmds.Get(),width,height)
		sts := VkDescriptorSet[2]
		sts[0] = atlas2 //vkPerspSet
		//sts[1] = modelTextureSet
		vk.Funcs.vkCmdBindDescriptorSets(cmds.Get(),VK_PIPELINE_BIND_POINT_GRAPHICS,textedLayout.Get(),0,1,sts[0]&,0,null)


		offsets := VkDeviceSize

		vk.Funcs.vkCmdBindVertexBuffers(cmds.Get(),0,1,gpuVertMem.GetBufferPointer(),offsets&)
		vk.Funcs.vkCmdBindIndexBuffer(cmds.Get(),gpuIndMem.GetBufferPointer()^,0,VKType(u32,1).GetBaseIndexType())

		vk.Funcs.vkCmdDrawIndexed(cmds.Get(),indCount,1,0,0,0)
	}

}


MeshData := class
{
	pos := vec2f
	uv := vec2f
}
