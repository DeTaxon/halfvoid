AppendClass ImContext
{
	selectedLine := int
	pg := int

	DrawFunc := !(HVB_Function^ fnc, bool^ retsData) -> void
	{
		// printf("yep %f\n",fnc)
		pos := vec2f(50,100)
		// DrawText(pos,"Hello world")
		margin := vec2f(0,26)

		pgSize := 30

		cSize := fnc.Lines.Size()
		cPtr := fnc.Lines.GetPointer()

		oPtr := fnc.Objects.GetPointer()

		// if cSize > 10
		// 	cSize = 10
		{
			// skip := buttons['S'] :? 5 : 1
			skip := 1
			if buttons['S']
				skip = 5
			switch newButton
			{
			case 'U'
				selectedLine -= skip
			case 'D'
				selectedLine += skip
			}
		}

		if selectedLine < 0
			selectedLine = 0
		if selectedLine >= cSize
			selectedLine = cSize - 1

		if selectedLine > pg + pgSize
			pg = selectedLine - pgSize
		if selectedLine < pg
			pg = selectedLine

		if pg < 0
			pg = 0

		shaderDataNode.ApplyShaderToQueue(vk,cmds.Get(),width,height)

		start := pg
		end := pg + pgSize
		if end >= cSize
			end = cSize - 1
		for i,ii : start..end
		{
			line := cPtr[i]
			
			p := pos + margin*ii->{float}

			if i == selectedLine
			{
				drawCube(p + vec2f(0.0,3.0),vec2f(570,26),vec4f(0.1,0.1,0.1,1.0))
			}
			DrawInt(p,i + 1)
			p += vec2f(50,0)

			DrawText(p,line.opcode.ToCStr())

			for j : 5
			{
				c := line.var1&[j]
				// if c == 0
				// 	continue
				DrawInt(p + vec2f(250 + 60*j,0), c)
			}

			if retsData != null and retsData[i]
				DrawText(p - vec2f(10,0),"!")

		}

		ln := cPtr[selectedLine]
		for j : 5
		{
			o := ln.var1&[j]
			if o == 0
				continue
			obj := oPtr[o]&

			ofst := pos + vec2f(580,j*26)

			DrawInt(ofst,o)
			drwPos := DrawText(ofst + vec2f(32,0),obj.UnitName)
			datOffst := ofst + vec2f(drwPos.x + 40,0)
			switch obj is
			{
			case MCConstInteger
				DrawInt(datOffst,obj.Value)
			case MCConstString
				DrawText(datOffst,obj.Value&->{Str^}^.CStr())
			}
		}
	}
}
