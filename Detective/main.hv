MeshData := class
{
	pos := vec2f
	uv := vec2f
}

main := !(Vector.{char^} args) -> void
{
	win := new Window(800,800,"Window")
	win.InitVulkan()

	cmds := TVkCommandBuffer(win.vInstance,win.vInstance.itDrawCmdPool2)

	vk := win.vInstance
	
	shadersDB := VulkanShaderLoader
	resMngr := VKResourceManager

	resMngr.inst = vk
	
	lightRenderPass := resMngr.CreateRenderPass(![
		TRenderPassFrame(vk.SwapImageFormat,	VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_PRESENT_SRC_KHR),
	],false)

	empty := TShaderInputVertexInfo	
	lightLayout := lightRenderPass.CreateLayout(empty,![],![
		new TVertexPushConstant(16)
	],
	1,
	topology = "TriangleFan"
	)
	
	textedLayout := lightRenderPass.CreateLayout(empty,![
		new TImageSet(1)
	],![
		new TVertexPushConstant(16)
	],
	1,
	topology = "TriangleFan"
	)

	meshLayout := lightRenderPass.CreateLayout(MeshData,![
		new TImageSet(1)
	],![
		new TVertexPushConstant(16)
	],
	1,
	topology = "Triangles"
	)

	// {
		img := NewImage_RGBA(512,512)
		memset(img.Data,255,512*512*4)
		dat := FSGetFile("./Goldman-Regular.ttf").GetBlob()
		// dat := FSGetFile("./JetBrainsMono-Bold.ttf").GetBlob()
		// NewOpenFont(dat,img,8)
		fontSize := 22
		oversampling := 2

		atlasTest := Vector.{u8}(512*512)

		packContext := stbtt_pack_context

		stbtt_PackBegin(packContext&,atlasTest.GetPointer(),512,512,512,1,null) //TODO unconst
		stbtt_PackSetOversampling(packContext&,oversampling,oversampling)

		chars := stbtt_packedchar[256]
		stbtt_PackFontRange(packContext&,dat.GetPointer(),0,fontSize,0,256,chars&) //TODO check result,

		stbtt_PackEnd(packContext&)

		ff := atlasTest.GetPointer()
		tt := img.GetPointer()
		for i : 512
		{
			for j : 512
			{
				c := ff[i + j*512]
				// tt[(i + j*512)*4 + 0] = c 
				// tt[(i + j*512)*4 + 1] = c 
				// tt[(i + j*512)*4 + 2] = c 
				// tt[(i + j*512)*4 + 3] = 255

				tt[(i + j*512)*4 + 0] =	255 
				tt[(i + j*512)*4 + 1] =	255 
				tt[(i + j*512)*4 + 2] =	255  
				tt[(i + j*512)*4 + 3] = c
			}
		}

		vkImg := vk.CreateTexture()
		vkImg.CreateTexture(img)
	// }
	
	shader := lightLayout.CreateShader( #EmbedVulkanShader("local:Square.vert"),#EmbedVulkanShader("local:Square.frag"))
	shaderText := textedLayout.CreateShader( #EmbedVulkanShader("local:Texture.vert"),#EmbedVulkanShader("local:Texture.frag"))
	shaderMesh := meshLayout.CreateShader( #EmbedVulkanShader("local:DrawMesh.vert"),#EmbedVulkanShader("local:DrawMesh.frag"))


	// txt := "-3.14"
	txt := "BbRr?"
	meshData := MeshData[20] //4*5
	indxs := int[30] // 2*3*5

	scale := 300

	xPos := 0.0
	yPos := 0.0
	for i : 5
	{
		gl := ref chars[txt[i]]

		meshData[i*4].pos.x = xPos

		meshData[i*4 + 0].uv.x = gl.x1 / 512
		meshData[i*4 + 1].uv.x = gl.x1 / 512
		meshData[i*4 + 2].uv.x = gl.x0 / 512
		meshData[i*4 + 3].uv.x = gl.x0 / 512

		meshData[i*4 + 0].uv.y = gl.y1 / 512
		meshData[i*4 + 1].uv.y = gl.y0 / 512
		meshData[i*4 + 2].uv.y = gl.y0 / 512
		meshData[i*4 + 3].uv.y = gl.y1 / 512

		xSize := (gl.xoff2 - gl.xoff) / scale
		ySize := (gl.yoff2 - gl.yoff) / scale

		j := i*4

		for tx : ![false,false,true,true] , ty : ![false,true,true,false]
		{
			wrt := ref meshData[j++]

			nowX := xPos + gl.xoff / scale
			nowY := yPos + gl.yoff / scale

			if tx 
			{	
				wrt.pos.x = nowX
			}else{
				wrt.pos.x = nowX + xSize
			}
			if ty 
			{
				wrt.pos.y = nowY
			}else{ 
				wrt.pos.y = nowY + ySize
			}
		}

		indxs[i*6 + 0] = i*4
		indxs[i*6 + 1] = i*4 + 1
		indxs[i*6 + 2] = i*4 + 2

		indxs[i*6 + 3] = i*4
		indxs[i*6 + 4] = i*4 + 2
		indxs[i*6 + 5] = i*4 + 3


		xPos += gl.xadvance / scale
	}

	// msh := vk.CreateMesh(meshData,indxs,VKType(u32,1))
	// gg := VKType
	// msh := vk.CreateMesh(null,null,gg)
	msh := vk.CreateMesh(BlobOnSpan2(meshData&,meshData->TypeSize),BlobOnSpan2(indxs&,indxs->TypeSize),VKType(u32,1))
	gSamplerNearest := VkSampler

	imV := VkSamplerCreateInfo()
	imV.magFilter = VK_FILTER_NEAREST
	imV.minFilter = VK_FILTER_NEAREST
	imV.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST
	imV.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
	imV.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
	imV.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE
	//imV.mpLodBias = 0.0f
	//imV.anisotropyEnable = VK_FALSE
	imV.maxAnisotropy = 1.0
	imV.compareEnable = VK_FALSE
	imV.compareOp = VK_COMPARE_OP_ALWAYS
	imV.minLod = 0.0
	imV.maxLod = 0.0
	imV.borderColor = VK_BORDER_COLOR_FLOAT_TRANSPARENT_BLACK
	//imV.unnormalizedCoordinates = VK_FALSE

	vk.Funcs.vkCreateSampler(vk.LogicalDevice,imV&,null,gSamplerNearest&)

	pool := textedLayout.CreateDescriptorPool(0,1)
	atlas := pool.CreateDescriptor()

	vSetTexture(vk,atlas,vkImg,gSamplerNearest)

	pool2 := meshLayout.CreateDescriptorPool(0,1)
	atlas2 := pool2.CreateDescriptor()
	vSetTexture(vk,atlas2,vkImg,gSamplerNearest)

	while not win.ShouldClose()
	{
		surfaceIndex := u32
		drawRes := true
		//@work vInstance.DrawGetImage(surfaceIndex&,drawRes&)
		@work win.vInstance.DrawGetImage(surfaceIndex&,drawRes&)

		cmds.Reset()
		cmds.Start()

		bar1 := VkImageMemoryBarrier()
		bar1.image = win.vInstance.surfaceImages^[surfaceIndex]
		bar1.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED
		bar1.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
		bar1.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT
		bar1.subresourceRange.levelCount = 1
		bar1.subresourceRange.layerCount = 1
		win.vInstance.Funcs.vkCmdPipelineBarrier(cmds.Get(),VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,0,0,null,0,null,1,bar1&)

		clrValues := vec4f(0.0,0.0,0.0,1.0)

		atm := VkRenderingAttachmentInfo()
		atm.imageView = win.vInstance.surfaceImageViews^[surfaceIndex]
		atm.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
		atm.resolveMode = VK_RESOLVE_MODE_NONE //TODO
		atm.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR
		atm.storeOp = VK_ATTACHMENT_STORE_OP_STORE
		memcpy(atm.clearValue&,clrValues&,4*4)

		rndr := VkRenderingInfo()
		rndr.renderArea.extent.width = win.vInstance.GetSurfaceWidth() //surfAb.currentExtent.width
		rndr.renderArea.extent.height = win.vInstance.GetSurfaceHeight() //surfAb.currentExtent.height
		rndr.layerCount = 1
		rndr.colorAttachmentCount = 1
		rndr.pColorAttachments&->{void^^}^ = atm&

		win.vInstance.Funcs.vkCmdBeginRendering(cmds.Get(),rndr&)

		shader.ApplyShaderToQueue(vk,cmds.Get(),800,800)
		vk.Funcs.vkCmdDraw(cmds.Get(),4,1,0,0)

		//shaderText.ApplyShaderToQueue(vk,cmds.Get(),800,800)
		//sts := VkDescriptorSet[2]
		//sts[0] = atlas //vkPerspSet
		////sts[1] = modelTextureSet
		//vk.Funcs.vkCmdBindDescriptorSets(cmds.Get(),VK_PIPELINE_BIND_POINT_GRAPHICS,textedLayout.Get(),0,1,sts[0]&,0,null)
		//vk.Funcs.vkCmdDraw(cmds.Get(),4,1,0,0)

		shaderMesh.ApplyShaderToQueue(vk,cmds.Get(),800,800)
		sts := VkDescriptorSet[2]
		sts[0] = atlas2 //vkPerspSet
		//sts[1] = modelTextureSet
		vk.Funcs.vkCmdBindDescriptorSets(cmds.Get(),VK_PIPELINE_BIND_POINT_GRAPHICS,textedLayout.Get(),0,1,sts[0]&,0,null)
		msh.Bind(cmds.Get())
		vk.Funcs.vkCmdDrawIndexed(cmds.Get(),5*6,1,0,0,0)
		// vk.Funcs.vkCmdDraw(cmds.Get(),5*6,1,0,0)

		win.vInstance.Funcs.vkCmdEndRendering(cmds.Get())

		bar1.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
		bar1.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR
		win.vInstance.Funcs.vkCmdPipelineBarrier(cmds.Get(),VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,0,0,null,0,null,1,bar1&)

		cmds.Stop()
		cmds.Submit(win.vInstance.DrawQueue,null)
		
		@work win.vInstance.DrawPresentImage(surfaceIndex)

		win.PollEvents()
		@work glfwWaitEventsTimeout(0.01)
	}
	// win.RunVulkan()
}
