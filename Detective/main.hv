
main := !(Vector.{char^} args) -> void
{
	win := new Window(800,800,"Window")
	win.InitVulkan()

	cmds := TVkCommandBuffer(win.vInstance,win.vInstance.itDrawCmdPool2)

	vk := win.vInstance
	
	shadersDB := VulkanShaderLoader
	resMngr := VKResourceManager

	resMngr.inst = vk

	im := ImContext
	im.Init(vk,resMngr&)
	im.InitFonts()

	TestNodes := ImNode[2]
	TestNodes[0].pos = vec2f(100.0,100.0)
	TestNodes[0].size = vec2f(200,200.0)
	TestNodes[0].color = vec4f(0.0,0.0,1.0,1.0)

	TestNodes[1].pos = vec2f(500.0,500.0)
	TestNodes[1].size = vec2f(100,100.0)
	TestNodes[1].color = vec4f(0.0,1.0,0.0,1.0)

	data := ImNodeData

	data.arrowsCount = 2
	data.arrows[0].source = 0
	data.arrows[0].target = 1
	data.arrows[1].source = 0
	data.arrows[1].subNode1 = 3
	data.arrows[1].target = 1
	data.arrows[1].subNode2 = 1

	fps := 0

	fpsCount := 0
	fpsTime := GetSteadyTime()

	textTest := char[256]

	strcpy(textTest[0]&,"Hello world")

	while not win.ShouldClose()
	{
		surfaceIndex := u32
		drawRes := true
		//@work vInstance.DrawGetImage(surfaceIndex&,drawRes&)
		@work win.vInstance.DrawGetImage(surfaceIndex&,drawRes&)

		fpsCount += 1

		now := GetSteadyTime()

		if now - fpsTime >= 1.0
		{
			fps = fpsCount
			fpsCount = 0
			fpsTime = now 
		}

		im.Inputs(buttons['q'] or MouseButtons[0],win.MousePosition)		

		cmds.Reset()
		cmds.Start()

		bar1 := VkImageMemoryBarrier()
		bar1.image = win.vInstance.surfaceImages^[surfaceIndex]
		bar1.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED
		bar1.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
		bar1.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT
		bar1.subresourceRange.levelCount = 1
		bar1.subresourceRange.layerCount = 1
		win.vInstance.Funcs.vkCmdPipelineBarrier(cmds.Get(),VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,0,0,null,0,null,1,bar1&)

		im.DrawStart(800,800,cmds&,win.vInstance.surfaceImageViews^[surfaceIndex])

		im.DrawNodes(TestNodes,data&)
		// im.DrawText(vec2f(44,44),"Test this",chars)
		im.DrawFloat(vec2f(0,0),fps)

		im.DrawTextEdit(vec2f(50,50),textTest[0]&,256)

		im.DrawEnd()

		win.vInstance.Funcs.vkCmdEndRendering(cmds.Get())

		bar1.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL
		bar1.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR
		win.vInstance.Funcs.vkCmdPipelineBarrier(cmds.Get(),VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,0,0,null,0,null,1,bar1&)

		cmds.Stop()
		cmds.Submit(win.vInstance.DrawQueue,null)
		
		@work win.vInstance.DrawPresentImage(surfaceIndex)

		win.PollEvents()
		@work glfwWaitEventsTimeout(0.01)
	}
	// win.RunVulkan()
}
