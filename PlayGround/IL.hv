

ILTest := !() -> void
{
	nums := 30

	values := new int[nums]
	res := new int[nums]

	// values[0] = 2
	// values[0] *= 10
	//
	// printf("test {0}\n",values[0])

	i := 0
	while i < nums
	{
		values[i] = 2
		i += 1
	}

	i = 0
	while i < nums
	{
		j := 0
		while j < nums
		{
			values[j] *= 10
			j += 1
		}
		j = nums - 1
		while j >= 1
		{
			thisMul := j
			thisDiv := 2*j + 1

			carry := (values[j] div thisDiv)*thisMul
			modul := values[j] mod thisDiv
			values[j] = modul
			j -= 1
			values[j] += carry
		}
		num := values[0] div 10
		values[0] = values[0] mod 10

		res[i] = num

		c := i

		while c > 0
		{
			if res[c] >= 10
			{
				res[c - 1] += 1
				res[c] = res[c] mod 10
			}
			c -= 1
		}

		i += 1
	}

	i = 0
	while i < nums
	{
		printf("{0}",res[i])
		i += 1
	}
	printf("\n")
}
