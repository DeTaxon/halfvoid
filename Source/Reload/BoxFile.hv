AppendClass BoxFile
{
	ReloadFile := !(HotloadContext^ ctx,File^ newFile) -> void
	{
		if parsingIt
			return void

		state = new CWorkParseFile(this&)
		WorkBag.AddWork(state)

		printf("called start of reload\n")

		parsingIt = true
		// TSpawnTask(() ==> [ctx,newFile] { //todo pass CurrentFile directly?
			ReloadFile2(ctx,newFile)

			state = null
			parsingIt = false
		// })

	}
	ReloadFile2 := !(HotloadContext^ ctx,File^ newFile) -> void
	{
		fileData = newFile.GetBlob()

		fileTokens = LoadFile(newFile,fileData,true)

		ParsedTokens.Destroy()

		oldData := ReloadFileOldData
		oldData.ctx = ctx

		oldData.Functions.Push(Functions[^])
		Functions.Destroy()

		oldData.FileClasses.Push(FileClasses[^])
		FileClasses.Destroy()

		oldData.FileClassTemplates.Push(FileClassTemplates[^])
		FileClassTemplates.Destroy()

		oldData.GlobalVars.Push(itGlobalVars[^])
		itGlobalVars.Destroy()

		for it,ind : FileEnums
			oldData.Enums[ind] = it
		FileEnums.Destroy()


		oldData.Typedefs.Push(Typedefs[^])
		Typedefs.Destroy()

		for it,ind : ClassAppends
		{
			oldData.ClassAppends.Emplace(it.0,it.1,it.2)
		}
		ClassAppends.Destroy()

		ParseAppends2(oldData&)
		ParseBlock(oldData&,fileTokens)

		//TODO deleted classtemplates,typedefs
		// ParseTypedefs(oldData&)
		// ParseAppendClasses(oldData&)
		// ParseFunctions(oldData&)
		// ReloadGlobals(fileTokens,oldData&)

		for fnc : oldData.Functions
		{
			if oldData.UsedFunctions.Contain(fnc)
				continue


			DB_FunctionCalls.Value.Get(fnc.AllFuncs[^][^], x ==> {ctx.AddFunction(x) })

			for spc : CodeSpaces
			{
				if spc.Templates.Contain(fnc.Name)
				{
					spc.Templates[fnc.Name].DeleteIf(x ==> {  return x == fnc})
				}
			}

			// DB_ForgetFunction(fnc)

			HotloadStream << "Removed function " << fnc.Name << "\n"
		}

		for cls : oldData.FileClasses
		{
			if oldData.UsedFileClasses.Contain(cls)
				continue

			for spc : CodeSpaces
			{
				if spc.Types.Contain(cls.Name) and spc.Types[cls.Name] == cls
				{
					spc.Types.Remove(cls.Name)
				}
			}

			DB_ClassExtends.Key.Get(cls, x ==> { ctx.AddClass(x) })
			DB_ClassUsesClass.Value.Get(cls, x ==> { ctx.AddClass(x) })

			HotloadStream << "Removed class " << cls.Name << "\n"
			DB_ForgetClass(ctx,cls)
		}

		for glb : oldData.GlobalVars
		{
			if oldData.UsedGlobalVars.Contain(glb)
				continue

			DB_ForgetGlobalVar(ctx,glb)

			HotloadStream << "Removed global variable " << glb.ItName << "\n"
		}

		for def : oldData.Typedefs
		{
			if oldData.UsedTypedefs.Contain(def)
				continue

			DB_ForgetTypedef(ctx,def)

			HotloadStream << "Removed typedef " << def.Name << "\n"
		}

		for app : oldData.ClassAppends
		{
			if oldData.UsedClassAppends.Contain(app.1)
				continue

			HotloadStream << "Remove append of class " << app.0 << "\n"

			cls := intGetClass2(app.0)->{BoxClassBody^}

			cls.Appends.DeleteIf(@1.1 == app.1)
			classAppends[app.0].DeleteIf(@1 == app.1)

			oldData.ctx.ReloadClasses.PushUniq(cls->{BoxClassBody^})

			HotloadStream << "Remove append of class " << app.0 << " appends count = " << cls.Appends.Size() << "\n"
		}
	}
}

ReloadFileOldData := class
{
	ctx := HotloadContext^

	Functions := List.{BoxFuncTemplateBody^}
	UsedFunctions := AVLSet.{BoxFuncTemplateBody^}

	FileClasses := List.{BoxClassBody^}
	UsedFileClasses := AVLSet.{BoxClassBody^}

	FileClassTemplates := List.{BoxClassTemplateBody^}
	UsedFileClassTemplates := AVLSet.{BoxClassTemplateBody^}


	GlobalVars := List.{GlobalVar2^}
	UsedGlobalVars := AVLSet.{GlobalVar2^}

	ClassAppends := List.{Tuple.{Str,Token^,u32}}
	UsedClassAppends := AVLSet.{Token^}

	Enums := AVLMap.{Str,Tuple.{BoxEnum^,TypeVar^}}

	Typedefs := List.{TypedefTemplateVar^}
	UsedTypedefs := AVLSet.{TypedefTemplateVar^}
	
}
