BoxFuncDeclare := class extend BoxFuncCommon
{
	itName := Str
	this := !(TypeFunc^ tp, Str fName) -> void
	{
		SetType(tp)
		itName = fName
	}

	PrintCode := virtual !(LLVMWriteContext^ ctx) -> void
	{
		if itName == ""
			return void

		f := ctx.writeStream

		f^ << "declare "
		PrintResultType(ctx)
		f^ << " @" << itName << "("
		PrintInputTypes(ctx)
		f^ << ")\n"
	}
	PrintName := virtual !(LLVMWriteContext^ ctx) -> void
	{
		ctx.writeStream^ << "@" << itName
	}
	GetName := virtual !() -> Str
	{
		return itName
	}
}

BoxFuncNonExist := class extend BoxFuncCommon
{
	this := !(TypeFunc^ tp) -> void
	{
		SetType(tp)
	}

	PrintCode := virtual !(LLVMWriteContext^ ctx) -> void
	{
	}
	PrintName := virtual !(LLVMWriteContext^ ctx) -> void
	{
		assert(false)
	}
	GetName := virtual !() -> Str
	{
		return ""
	}
}
