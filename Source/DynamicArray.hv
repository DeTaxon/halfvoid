TypeDynamicArray := class extends TypePointLike
{
	this := !(Type^ b) -> void
	{
		Base = b
		ItHash = typeHashIterator
		typeHashIterator += 1

		if DebugMode
		{
			MetaId = GetNewId()
		}
	}

}

CreateBuiltinsDynamicArrays := !() -> void
{
	bSpace := CodeSpaces[-1]&
	bSpace.Templates["="].Push(new DynamicArrayStoreTemplate)
	bSpace.Templates["Push"].Push(new DynamicArrayPushTemplate)
	bSpace.Templates["Emplace"].Push(new DynamicArrayEmplaceTemplate)
	bSpace.Templates["[]"].Push(new DynamicArrayGetElementTemplate)
	// bSpace.Templates["Template"].Push()
}

DynamicArrayStoreTemplate := class extend BoxFuncTemplate
{
	this := !() -> void
	{
	}
	ToFuncType := virtual !(Vector.{BoxExeObj^} objs, Vector.{BoxExeConstObj^} consts) -> TypeFunc^
	{
		if objs.Size() != 2
			return null
		if not objs[0].IsMem()
			return null
		a := objs[0].GetType()
		if a is in TypeDynamicArray
		{
			return GetFuncType(2,![a,a],![true,false],GTypeVoid,false,false)
		}
		return null
	}
	CreateFunc := virtual !(TypeFunc^ tp, Vector.{BoxExeConstObj^} consts) -> BoxFunc^
	{
		return new BuiltInPrimeStore(tp)
	}
}

DynamicArrayPushTemplate := class extend BoxFuncTemplate
{
	this := !() -> void
	{
	}
	ToFuncType := virtual !(Vector.{BoxExeObj^} objs, Vector.{BoxExeConstObj^} consts) -> TypeFunc^
	{
		if objs.Size() != 2
			return null
		if objs[0].GetType() is not TypeDynamicArray
			return null

		base := objs[0].GetType().Base

		tst := BlankObjectExe(base,true)

		setTest := CreateFuncCall("=",![tst&,tst&]) // TODO emit error

		if setTest == null
			return null

		return GetFuncType(![base.GetDynamicArray(),base],GTypeVoid)
	}
	CreateFuncCall := virtual !(Vector.{BoxExeObj^} objs,Vector.{BoxExeConstObj^} consts,FuncInputObjects^ iObjs) -> BoxExeObj^
	{
		objBase := objs[0]
		if objBase.IsMem()
		{
			objBase.NotifyMemUse()
			objBase = CreateFuncCall("internalDynamicArrayCheckExistance",![new UnrefFuncCall(objBase)])
			assert(objBase != null)
		}
		addElement := CreateFuncCall("internalDynamicArrayAddElement",![objBase])
		assert(addElement != null)
		return CreateFuncCall("=",![addElement,objs[1]])
	}
}
DynamicArrayEmplaceTemplate := class extend BoxFuncTemplate
{
	this := !() -> void
	{
	}
	GetPriority := virtual !(Vector.{BoxExeObj^} objs, Vector.{BoxExeConstObj^} consts,FuncInputObjects^ iObjs) -> int
	{
		if objs.Size() == 0
			return CmpNoExchange
		if objs[0].GetType() is not TypeDynamicArray
			return CmpNoExchange

		subObjs := MakeVectorOnStack.{BoxExeObj^,20}()

		asBase := BlankObjectExe(objs[0].GetType().Base,true)

		for it,i : objs
		{
			if i == 0
				continue
			subObjs.Push(it)
		}

		constrTest := innerTryGetMethodCall("this",asBase&,subObjs,![])

		if constrTest == null
			return CmpNoExchange

		return 0
	}
	CreateFuncCall := virtual !(Vector.{BoxExeObj^} objs,Vector.{BoxExeConstObj^} consts,FuncInputObjects^ iObjs) -> BoxExeObj^
	{
		objBase := objs[0]
		if objBase.IsMem()
		{
			objBase.NotifyMemUse()
			objBase = CreateFuncCall("internalDynamicArrayCheckExistance",![new UnrefFuncCall(objBase)])
			assert(objBase != null)
		}
		addElement := CreateFuncCall("internalDynamicArrayAddElement",![objBase])
		assert(addElement != null)

		subObjs := MakeVectorOnStack.{BoxExeObj^,20}()

		for it,i : objs
		{
			if i == 0
				continue
			subObjs.Push(it)
		}
		return innerTryGetMethodCall("this",addElement,subObjs,![])
	}
}

DynamicArrayGetElementTemplate := class extend BoxFuncTemplate
{
	this := !() -> void
	{
	}

	ToFuncType := virtual !(Vector.{BoxExeObj^} objs, Vector.{BoxExeConstObj^} consts) -> TypeFunc^
	{
		if objs.Size() != 2
			return null
		tp0 := objs[0].GetType()
		if tp0 is not TypeDynamicArray
			return null
		if not objs[1].GetType().IsInt()
			return null
		return GetFuncType(![tp0,GTypeInt],![false,false],tp0.Base,true)
	}
	CreateFunc := virtual !(TypeFunc^ tp, Vector.{BoxExeConstObj^} consts) -> BoxFunc^
	{
		tp1 := BlankObjectExe(tp.Params[0].ItType,false)
		tp2 := BlankObjectExe(GTypeInt,false)
		CreateFuncCall("internalDynamicArrayGetElement",![tp1&,tp2&]) // create function in template
		return new BuiltInPointGetItem(tp)
	}
}
