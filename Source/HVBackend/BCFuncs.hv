
BCFuncs := BCFuncsType

BCFuncsType := class
{
	
	baseFuncs := AVLMap.{BoxFuncBody^,MCFunction^}
	interpFuncs := AVLMap.{BoxFuncBody^,MCFunction^}
	x8664Funcs := AVLMap.{BoxFuncBody^,MCFunction^}

	ssaFuncs := AVLMap.{BoxFuncBody^,HVB_Function^}
	llvmFuncs := AVLMap.{BoxFuncBody^,HVB_Function^}

	ForgetFunction := !(BoxFuncBody^ fnc) -> void
	{
		baseFuncs.Remove(fnc)
		interpFuncs.Remove(fnc)
		x8664Funcs.Remove(fnc)
		ssaFuncs.Remove(fnc)
	}

	GetBaseFunc := !(BoxFuncBody^ itm) -> MCFunction^
	{
		if baseFuncs.Contain(itm)
			return baseFuncs[itm]

		itm.ParseBody()
		itm.WaitReadyState()

		buildCtx := MCBuildContext
		buildCtx.Init()
		itm.CreateMCFunction(buildCtx&)
		result = buildCtx.CreateMCFunction()
		result.BaseFunction = itm

		// result.Print()
		baseFuncs[itm] = result
	}
	GetInterpFunc := !(BoxFuncBody^ itm) -> MCFunction^
	{
		if interpFuncs.Contain(itm)
			return interpFuncs[itm]

		hmAlloc := SwapAllocator(GetDefaultAllocator())
		defer SetAllocator(hmAlloc)

		result = GetBaseFunc(itm)
		// assert(false)

		tmpAlloc := MakeTempAllocator()
		oldAlloc := SwapAllocator(tmpAlloc&)

		result = PassRemoveReferences(result)
		result = PassFixDynamicArrays(result)
		result = PassLazyLoadLibGlobals(result)

		// result = PassAddStackInterp(result)
		// result = PassStackRemovePushPop(result)

		result = PassFirstOpt(result,false)

		result = PassRemMoveAndCastOpt(result)

		result = InterpPassPrepare(result)

		result = PassRemoveUnusedObjects(result)

		SetAllocator(oldAlloc)
		result = PassFinalizeFunction(result)
		tmpAlloc.Destroy()

		result.ComputeStackFrame()
		result.BaseFunction = itm

		interpFuncs[itm] = result
	}

	GetFunc_Interp_x86_64 := !(BoxFuncBody^ itm) -> MCFunction^
	{
		if x8664Funcs.Contain(itm)
			return x8664Funcs[itm]

		result = GetBaseFunc(itm)

		tmpAlloc := MakeTempAllocator()
		oldAlloc := SwapAllocator(tmpAlloc&)

		result = PassFirstOpt(result,false)
		result = PassLazyLoadLibGlobals(result)

		result = InterpPassPrepare(result)
		result.BaseFunction = itm

		// if itm.OutputName == "RunFunc"
		// 	result.Print()
		result = PassRemoveSpaceship(result)
		result = PassSimplifyVectors(result)
		result = PassRemoveVoidParams(result)
		// result.Print()
		result = PassRemoveReferences(result)
		result = PassFixDynamicArrays(result)
		// result = PassOptimizeJumpX86(result)
		// result.Print()
		result = PassSetFallbacksX86(result)
		// if itm.OutputName == "RunFunc"
		// 	result.Print()
		result = PassApplyRegistersX86(result)
		// if itm.OutputName == "RunFunc"
		// 	result.Print()

		result = PassSomeOptimizationsX86(result)
		// if itm.OutputName == "RunFunc"
		// 	result.Print()
		result = PassRemoveRegCopies(result)

		SetAllocator(oldAlloc)
		result = PassRemoveUnusedObjects(result)
		tmpAlloc.Destroy()

		// if itm.OutputName == "RunFunc"
		// 	result.Print()

		x8664Funcs[itm] = result
	}

	GetFunc_SSA := !(BoxFuncBody^ fnc) -> HVB_Function^
	{
		return ssaFuncs[fnc]?

		ret := GetBaseFunc(fnc)

		ret = PassRemoveSpaceship(ret)
		ret = PassSimplifyVectors(ret)
		ret = PassRemoveVoidParams(ret)
		ret = PassRemoveReferences(ret)
		ret = PassForceReturnConstValues(ret)
		ret = PassCreateConstValues(ret)
		ret = PassAddingCastForPtrMove(ret)
		ret = PassCleanupFloats(ret)
		ret = PassRemoveTooManyVars(ret)
		ret = PassRemoveUnusedObjects(ret)

		result = ret
		ssaFuncs[fnc] = result
	}
	GetFunc_LLVM := !(BoxFuncBody^ fnc) -> HVB_Function^
	{
		return llvmFuncs[fnc]?

		ret := GetBaseFunc(fnc)

		tmpAlloc := MakeTempAllocator()
		oldAlloc := SwapAllocator(tmpAlloc&)

		// if needPrint ret.Print()
		//

		ret := PassRemoveSpaceship(ret)
		ret = PassSimplifyVectors(ret)
		ret = PassRemoveVoidParams(ret)
		ret = PassRemoveReferences(ret)
		ret = PassFixDynamicArrays(ret)
		//ret = PassNormalizeTypes(ret)
		ret = PassForceReturnConstValues(ret)
		// if needPrint ret.Print()
		// if needPrint ret.Print()
		ret = PassForceReturnConstValues(ret)
		// if needPrint ret.Print()
		ret = PassCreateConstValues(ret)
		// if needPrint ret.Print()
		ret = PassAddingCastForPtrMove(ret)
		// if needPrint ret.Print()
		ret = PassRemoveTooManyVars(ret)
		// if needPrint ret.Print()

		ret = PassRemoveUnusedObjects(ret)
		SetAllocator(oldAlloc)

		ret = PassFinalizeFunction(ret)
		// defer delete ret

		tmpAlloc.Destroy()

		llvmFuncs[fnc] = ret

		return ret
	}
}

