
PassILReplaceCLib := !(MCFunction^ fnc) -> MCFunction^
{
	bldr := MakeGreedyPass(fnc,4,6)

	c := ref bldr.cmdsSize
	cPtr := bldr.cmds.GetPointer()

	o := ref bldr.objsSize
	oPtr := bldr.objs.GetPointer()

	lin := fnc.Lines.GetPointer()

	size := fnc.Lines.Size()

	arrAccess := int[int]

	getElement := (int id) ==> {
		if arrAccess.Contain(id)
		{
			old := lin[arrAccess[id]]

			cPtr[c++] = MCLine("il_push",old.var2)
			cPtr[c++] = MCLine("il_push",old.var3)
			cPtr[c++] = MCLine("il_ldelem",bldr.PushStr("i4"))
		}else{
			cPtr[c++] = MCLine("il_push",id)
		}
	}

	preStore := (int id) ==> {
		if arrAccess.Contain(id)
		{
			old := lin[arrAccess[id]]
			cPtr[c++] = MCLine("il_push",old.var2)
			cPtr[c++] = MCLine("il_push",old.var3)
		}
	}
	storeElement := (int id) ==> {
		if arrAccess.Contain(id)
		{
			cPtr[c++] = MCLine("il_stelem",bldr.PushStr("i4"))
		}else{
			cPtr[c++] = MCLine("il_pop",id)
		}
	}

	i := 0
	while i < fnc.Lines.Size()
	{
		line := lin[i]

		switch line.opcode
		{
		case "load_element"
			tp := oPtr[line.var1].GetType()

			obj := oPtr[line.var1]&->{MCVariable^}
			obj->SetType(MCVariable)
			obj.GetValueType() = tp

			arrAccess[line.var1] = i

			i += 1
		case in !["add","sub","mul","div","mod"]
			preStore(line.var1)
			getElement(line.var2)
			getElement(line.var3)
			cPtr[c++] = MCLine(line.opcode)
			storeElement(line.var1)
			i += 1
		case "mov"
			preStore(line.var1)
			getElement(line.var2)
			storeElement(line.var1)
			i += 1
		case "cast"
			preStore(line.var1)
			getElement(line.var2)
			cPtr[c++] = MCLine("cast",line.var1)
			storeElement(line.var1)
			i += 1
		case "call_start"
			fncObj := oPtr[line.var2]&

			fnc := BoxFuncDeclare^

			switch fncObj is
			{
			case MCConstFunction

				if fncObj.GetValue() is BoxFuncDeclare
					fnc = fncObj.GetValue()->{BoxFuncDeclare^}

			case void assert(false)
			}

			assert(fnc != null)

			args := HybridQueue.{int,20}

			i += 1
			while lin[i].opcode != "call_end"
			{
				args.Push(lin[i].var1)
				i += 1
			}

			switch fnc.itName
			{
			case "printf"

				if args.Size() == 1
				{
					getElement(args[0])
					cPtr[c++] = MCLine("il_call",bldr.PushStr("void class [mscorlib]System.Console::Write(string)"))
				}else{

					originalStr := oPtr[args[0]]&->{MCConstString^}.GetValue().CStr()

					newStr := malloc(1024)->{char^}

					k := 0
					index := 0
					while originalStr[k] != 0
					{
						if originalStr[k] == '%'
						{
							newStr[k++] = '{'
							newStr[k++] = '0' + index++ // TODO case for 10+
							newStr[k++] = '}'
						}else{
							newStr[k] = originalStr[k]
							k += 1
						}
					}
					newStr[k] = 0

					vr  := bldr.PushVar(GTypeILObject.GetDynamicArray())

					cPtr[c++] = MCLine("new",vr,bldr.PushInt(args.Size() - 1))

					for it,i : args
					{
						if i == 0
							continue

						cPtr[c++] = MCLine("il_push",vr)
						cPtr[c++] = MCLine("il_push",bldr.PushInt(i - 1))
						// cPtr[c++] = MCLine("il_push",it)
						getElement(it)
						cPtr[c++] = MCLine("il_box",it)
						cPtr[c++] = MCLine("il_stelem",bldr.PushStr("ref"))

					}
					cPtr[c++] = MCLine("il_push",args[0])
					cPtr[c++] = MCLine("il_push",vr)
					cPtr[c++] = MCLine("il_call",bldr.PushStr("void class [mscorlib]System.Console::Write(string,object[])"))
				}
			case none
				assert(false)

			}
		case void
			cPtr[c++] = line
			i += 1
		}
	}
	
	return bldr.GenerateFunc()
}
