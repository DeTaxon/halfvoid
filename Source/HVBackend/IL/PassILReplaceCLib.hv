
PassILReplaceCLib := !(MCFunction^ fnc) -> MCFunction^
{
	bldr := MakeGreedyPass(fnc,4,6)

	c := ref bldr.cmdsSize
	cPtr := bldr.cmds.GetPointer()

	o := ref bldr.objsSize
	oPtr := bldr.objs.GetPointer()

	lin := fnc.Lines.GetPointer()


	size := fnc.Lines.Size()

	i := 0
	while i < fnc.Lines.Size()
	{
		line := lin[i]

		if line.opcode == "load_element" and  i + 1 < size and lin[i+1].opcode == "mov"
		{
			cPtr[c++] = MCLine("il_push",line.var2)
			cPtr[c++] = MCLine("il_push",line.var3)
			cPtr[c++] = MCLine("il_push",lin[i+1].var2)
			cPtr[c++] = MCLine("il_stelem",bldr.PushStr("i4"))
			i += 2
			continue
		}

		if line.opcode == "mov"
		{
			cPtr[c++] = MCLine("il_push",line.var2)
			cPtr[c++] = MCLine("il_pop",line.var1)
			i += 1
			continue
		}

		if line.opcode == "call_start"
		{
			fncObj := oPtr[line.var2]&

			fnc := BoxFuncDeclare^

			switch fncObj is
			{
			case MCConstFunction

				if fncObj.GetValue() is BoxFuncDeclare
					fnc = fncObj.GetValue()->{BoxFuncDeclare^}

			case void assert(false)
			}

			assert(fnc != null)

			args := HybridQueue.{int,20}

			i += 1
			while lin[i].opcode != "call_end"
			{
				args.Push(lin[i].var1)
				i += 1
			}

			switch fnc.itName
			{
			case "printf"

				if args.Size() == 1
				{
					cPtr[c++] = MCLine("il_push",args[0])
					cPtr[c++] = MCLine("il_call",bldr.PushStr("void class [mscorlib]System.Console::Write(string)"))
				}else{

					originalStr := oPtr[args[0]]&->{MCConstString^}.GetValue().CStr()

					newStr := malloc(1024)->{char^}

					k := 0
					index := 0
					while originalStr[k] != 0
					{
						if originalStr[k] == '%'
						{
							newStr[k++] = '{'
							newStr[k++] = '0' + index++ // TODO case for 10+
							newStr[k++] = '}'
						}else{
							newStr[k] = originalStr[k]
							k += 1
						}
					}
					newStr[k] = 0

					vr  := bldr.PushVar(GTypeILObject.GetDynamicArray())

					cPtr[c++] = MCLine("new",vr,bldr.PushInt(args.Size() - 1))

					for it,i : args
					{
						if i == 0
							continue

						cPtr[c++] = MCLine("il_push",vr)
						cPtr[c++] = MCLine("il_push",bldr.PushInt(i - 1))
						cPtr[c++] = MCLine("il_push",it)
						cPtr[c++] = MCLine("il_box")
						cPtr[c++] = MCLine("il_stelem",bldr.PushStr("ref"))

					}
					cPtr[c++] = MCLine("il_push",args[0])
					cPtr[c++] = MCLine("il_push",vr)
					cPtr[c++] = MCLine("il_call",bldr.PushStr("void class [mscorlib]System.Console::Write(string,object[])"))
				}
			case none
				assert(false)

			}
			

		}else{
			cPtr[c++] = line
		}
		i += 1
	}
	
	return bldr.GenerateFunc()
}
