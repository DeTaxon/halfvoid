AppendClass BoxClassBody
{
	ReloadClass := !(HotloadContext^ ctx) -> void
	{
		if not startedParse
			return void

		assert(not reloadInProgress)

		oldSize := 0
		if FieldsState.IsEmitted() 
			oldSize = GetSize()

		thisWork = null
		FieldsState.Reset()

		AddClassWork()

		SubWork (() ==> [c = this&,ctx,oldSize] {
			c.ReloadClassCore(ctx,oldSize)
		})
	}

	nowOldData := ClassReloadOldData^

	reloadInProgress := bool //TODO bugfix, who calls ReloadClass twice? remove after making better reload

	ReloadClassCore := !(HotloadContext^ ctx,int oldSize) -> void
	{
		if reloadInProgress
			return void
		reloadInProgress = true
		defer reloadInProgress = false

		className := GetGoodName()

		HotloadStream << "Started reload of class " << className << "\n"

		oldData := nowOldData

		if oldData == null
		{
			oldData = new ClassReloadOldData
			oldData.ctx = ctx

			for it, ind : DefaultSpace.MethodTemplates
			{
				setLine := ref oldData.OldFuncTemplates[ind]
				setLine.Push(it[^])
			}
			for it, ind : DefaultSpace.Methods
			{
				setLine := ref oldData.OldFuncs[ind]
				setLine.Push(it[^])
			}

			for it, ind : PreVTableFuncs
			{
				setLine := ref oldData.OldFuncs[ind]
				setLine.Push(it[^])

				oldData.OldVirtualFuncs.Insert(it[^])
			}

			oldData.VTableType = VTableType
			oldData.VTableValue = VTableValue
			oldData.VTableField = VTableField
			oldData.VTable.Push(VTable[^])

			oldData.OldFields.Push(Fields[^])
			oldData.OldFieldPaths.Push(FieldsPath[^])

			for it,name : PoisonFunctions
				oldData.OldPoisonFuncs[name] = it.2

			for it, name : PoisonFields
				oldData.OldPoisonFields[name] = it.2
		}
	
		oldHash := GetMemStructureHash()

		PrimeParents.Destroy()
		Parents.Destroy()

		DefaultSpace.MethodTemplates.Destroy()

		Fields.Destroy()
		FieldsPath.Destroy()
		FieldsState.Reset()

		VTable.Destroy()
		VTableType = null
		VTableValue = null
		VTableField = null

		PreVTableFuncs.Destroy()
		PreVTableVars.Destroy()

		DefaultSpace.Methods.Destroy()
		DefaultSpace.MethodTemplates.Destroy()

		DefaultSpace.VirtualMethods.Destroy()
		DefaultSpace.VirtualCleanMethods.Destroy()

		PoisonFunctions.Destroy()
		PoisonFields.Destroy()

		VirtualTables.Key.RemoveAll(this&)

		thisWork = null

		if not ParseHeader(oldData)
		{
			return void
		}


		AddClassWork().oldData = oldData
		res := WorkBody(oldData)

		if not res
		{
			HotloadStream << "Class " << className << " failed to compile\n"
			return void
		}

		newSize := GetSize()
		newHash := GetMemStructureHash()

		if newSize != oldSize
		{
			HotloadStream << "Class " << className << " changed size from " << oldSize << " to " << newSize << "\n"
			

			cnt := DB_TypeSizeUsage.bckwrd.Contain(this&) ?: "true" : "false"

			DB_TypeSizeUsage.Value.Get(this&,x ==> {
				if x is in BoxFuncBody
				{
					ctx.ReloadFunctions.PushUniq(x->{BoxFuncBody^})
				}
			})
			DB_LocalVarUsage.Value.Get(this&,x ==> {
				if x is in BoxFuncBody
				{
					ctx.ReloadFunctions.PushUniq(x->{BoxFuncBody^})
				}
			})
		}

		reloadSubClasses := () ==> {
			bag := List.{BoxClass^}
			bag.Push(this&)

			while bag.Size() != 0
			{
				itm := bag.Pop()
				DB_ClassExtends.Value.Get(itm, x ==> { 
					bag.Push(x)
					ctx.AddClass(x) 
				})
			}
			ctx.ChangedVirtualTables.Push(this&)
		}

		if VTableType != oldData.VTableType
		{
			HotloadStream << "Class " << className << " changed virtual table\n"
			reloadSubClasses()
		}

		for it : oldData.OldVirtualFuncs
		{
			if oldData.UsedAsVirtualFuncs.Contain(it)
				continue
			DB_FunctionVirtualCalls.Value.Get(it, x ==> { ctx.AddFunction(x) })
		}


		// function changed from regular to virtual, need to promote regular call to virtual
		// for funcList, name : PreVTableFuncs
		// {
		// 	for func : funcList
		// 	{
		// 		if not oldData.RecoveredFuncs.Contain(func)
		// 			continue
		//
		// 		if oldData.OldVirtualFuncs.Contain(func)
		// 			continue
		//
		// 		DB_FunctionCalls.Value.Get(func,x ==> { ctx.AddFunction(x) })
		// 	}
		// }
		for base : oldData.OldFuncs
		{
			for func : base
			{
				if oldData.RecoveredFuncs.Contain(func)
					continue
				if oldData.UsedAsVirtualFuncs.Contain(func)
					continue
		 		DB_FunctionCalls.Value.Get(func,x ==> { ctx.AddFunction(x) })
			}
		}

		for base : oldData.OldFuncs
		{
			for func : base
			{
				if oldData.RecoveredFuncs.Contain(func)
					continue
		 		DB_FunctionCalls.Value.Get(func,x ==> { ctx.AddFunction(x) })
			}
		}

		for base : oldData.OldFuncTemplates
		{
			for func : base
			{
				if oldData.RecoveredFuncTemplates.Contain(func)
					continue
		 		DB_FunctionCalls.Value.Get(func.AllFuncs[^][^],x ==> { ctx.AddFunction(x) })
			}
		}

		changedPoison := false

		for name : oldData.UsedPoisonFuncs
		{
			hash := oldData.OldPoisonFuncs[name]

			if not PoisonFunctions.Contain(name) 
				continue

			if PoisonFunctions[name].2 == hash
				continue

			changedPoison = true
		}

		for hash,name : oldData.OldPoisonFuncs
		{
			if oldData.UsedPoisonFuncs.Contain(name)
				continue
			HotloadStream << "Deleted poison func\n"
			changedPoison = true // poison func deleted
		}


		for it,name : PoisonFunctions
		{
			if oldData.UsedPoisonFuncs.Contain(name)
				continue
			changedPoison = true // added new function
		}

		for hash,name : oldData.OldPoisonFields
		{
			if oldData.UsedPoisonFields.Contain(name)
				continue
			HotloadStream << "Deleted poison Fields\n"
			changedPoison = true // poison field deleted
		}
		for it,name : PoisonFields
		{
			if oldData.UsedPoisonFields.Contain(name)
				continue
			changedPoison = true // added new fields
		}

		if changedPoison
		{
			reloadSubClasses()
		}

		if oldData.VTableValue != VTableValue 
		{
			DB_FuncUsesGlobal.Value.Get(oldData.VTableValue, x ==> { ctx.AddFunction(x) })
			DB_VTableUsage.Key.Get(this&, x ==> {ctx.AddFunction(x) })
			// DB_TypeSizeUsage.Value.Get(this&, x ==> {ctx.AddFunction(x) }) // TODO internalInitClass does not update on VTableIsage, fix it by absorbing InitClass
		}

	

		if oldHash != newHash
		{
			HotloadStream << "Class " << className << " changed structure\n"
			DB_LocalVarUsage.Value.Get(this&,x ==> {
				if x is in BoxFuncBody
					ctx.ReloadFunctions.PushUniq(x->{BoxFuncBody^})
			})
			DB_FieldUsage.Value.Get(this&,x ==> {
				if x is in BoxFuncBody
					ctx.ReloadFunctions.PushUniq(x->{BoxFuncBody^})
			})

			DB_ClassExtends.Value.Get(this&, x ==> {
				HotloadStream << "Reloading class \n"
				if x is in BoxClassBody
				{
					ctx.ReloadClasses.PushUniq(x->{BoxClassBody^})
				}
			})
			DB_ClassExtends.Value.RemoveAll(this&)
		}

		HotloadStream << "Reload result: Recovered  Function templates = " << oldData.RecoveredFuncTemplates.Size()
			<< " , Functions = " << oldData.RecoveredFuncs.Size() << "/" << oldData.OldFuncs.Size()
			<< " , Fields = " << oldData.RecoveredFields.Size() << "/" << oldData.OldFields.Size()
			<< "\n"

		HotloadStream << "End of reload of class " << className << "\n"
		HotloadStream << "New Size " << GetSize() << "\n"

		nowOldData = null
	}

	GetMemStructureHash := !() -> u32
	{
		hs := Crc32
		for it : Parents
		{
			th := it.ItHash
			hs.Feed(th&,4)
		}
		for it : Fields
		{
			th := it.Value.ItHash
			hs.Feed(th&,4)
		}
		return hs.Get()
	}
}


ClassReloadOldData := class
{
	ctx := HotloadContext^

	OldFuncs := AVLMap.{Str,List.{BoxFunc^}}
	RecoveredFuncs := AVLSet.{BoxFunc^}

	OldVirtualFuncs := AVLSet.{BoxFunc^}
	UsedAsVirtualFuncs := AVLSet.{BoxFunc^}

	OldPoisonFuncs := AVLMap.{Str,u32}
	UsedPoisonFuncs := AVLSet.{Str}

	OldFuncTemplates := AVLMap.{Str,List.{BoxFuncTemplate^}}
	RecoveredFuncTemplates := AVLSet.{BoxFuncTemplate^}

	OldFields := List.{FieldParam^}
	OldFieldPaths := List.{FieldPath^}
	RecoveredFields := List.{FieldParam^}

	OldPoisonFields := AVLMap.{Str,u32}
	UsedPoisonFields := AVLSet.{Str}

	VTableType := BoxClass^
	VTableValue := GlobalVar2^
	VTableField := FieldPath^ 
	VTable := List.{VTableEntry^}

}
