BoxCodeSpace := class
{
	Files := List.{BoxFile^}
	Folders := List.{Str}

	Templates := AVLMap.{Str,List.{BoxFuncTemplate^}}
	Functions := AVLMap.{Str,List.{BoxFunc^}} //only for builtin functions
	Globals := AVLMap.{Str,List.{BoxUnit^}}

	ExchangeTableFuncs :=  Vector.{BoxUnit^}
	ExchangeTableTemplates := Vector.{BoxUnit^}

	Types := HashMap.{Str,BoxUnit^}

	Modules := List.{ModuleInterface^}

	AddTemplate := !(Str name, BoxFuncTemplate^ newTempl) -> void
	{
		Templates[name].Push(newTempl)
		if name == "->{}"
			ExchangeTableTemplates.Push(newTempl)
	}
	AddFunction := !(Str name, BoxFunc^ newFnc) -> void
	{
		Functions[name].Push(newFnc)
		if name == "->{}"
			ExchangeTableFuncs.Push(newFnc)
	}
}


BoxFile := class extend BoxUnit
{
	fileId := int
	file := File^
	fileData := Blob^
	fileName := Str

	ThisCodeSpace := BoxCodeSpace^

	loaded := THatch

	FileClasses := List.{BoxClassBody^}
	FileClassTemplates := List.{BoxClassTemplateBody^}
	Functions := List.{BoxFuncTemplateBody^}
	FileEnums := AVLMap.{Str,Tuple.{BoxEnum^,TypeVar^,u32}}

	Typedefs := List.{TypedefTemplateVar^}

	ClassAppends := List.{Tuple.{Str,Token^,u32}}

	fileTokens := Token^
	tokensChanged := bool

	itGlobalVars := List.{GlobalVar2^}

	ParsedTokens := AVLSet.{Token^}

	this := !(File^ inFile) -> void
	{
		fileId = GetNewId()
		file = inFile
		fileData = file.GetBlob()
		fileName = file.GetName()
	}
	GetName := !() -> StringSpan
	{
		result = fileName
	}

	LoadFiles := !() -> void
	{
		fileTokens = this.LoadFile(file,fileData,false)
	}
	LoadFile := !(File^ newFile,Blob^ fileValue, bool forceLoad) -> Token^
	{
		resultTokens := Token^

		blb := Blob^
		if not forceLoad
			blb = TryGetCacheOfFile(newFile)
		if blb != null
		{
			if blb.Size() == 0
				return void
			s := StreamReadBlob(blb.GetPointer(),blb.Size())
			resultTokens = LoadCachedTokens(s&,this&)
		}
		if resultTokens == null
		{
			tokens := GetObjectsFromMemory(this&,fileValue.GetPointer()->{char^},fileValue.Size())

			if tokens == null
				return void

			tokensChanged = true

			resultTokens = new Token

			resultTokens.Down = tokens
			itr := tokens
			while itr != null
			{
				itr.Up = resultTokens
				itr = itr.Right
			}

			SyntaxCompress(resultTokens,LexHVFileRoot)
		}
		return resultTokens
	}
	AddClass := !(Str name, PClassParser^ d) -> BoxUnit^
	{
		cls := d.CreateObject()

		if cls is in BoxClassBody
		{
			cls2 := cls->{BoxClassBody^}
			cls2.SetName(name)
			clsVar := new TypeVar(name,cls2)
			CurrentCodeSpace.Types[name] = clsVar
			FileClasses.Push(cls2)
			cls2.ClassFile = this&
			cls2.hash = d.ComputeHash(fileData)
			result = cls2
		} else if cls is in BoxClassTemplateBody
		{
			cls3 := cls->{BoxClassTemplateBody^}
			cls3.SetName(name)
			templateVar := new TemplateTypeVar(name,cls3)
			CurrentCodeSpace.Types[name] = templateVar
			FileClassTemplates.Push(cls3)
			result = cls3
		}else{
			assert(false)
		}
		
	}

	ParseAppends2 := !(ReloadFileOldData^ oldData = null) -> void
	{
		if fileTokens == null
			return void

		itr := fileTokens.Down

		while itr != null
		{
			ParseAppends2Round(oldData,itr)
			itr = itr.Right
		}
	}
	ParseAppends2Round := !(ReloadFileOldData^ oldData,Token^ itr) -> void
	{
		if itr.Down == null
			return void
		if itr.Down.GetValue() != "AppendClass"
			return void

		name := itr.Down.Right->{TokenIndent^}.Value
		root := itr.Down.Right.Right

		hash := ComputeHash(root)
		oldAppend := Token^

		if oldData != null
		{
			for it : oldData.ClassAppends
			{
				if it.0 != name
					continue
				if it.2 != hash
					continue
				
				oldAppend = it.1
				break
			}

		}

		if oldAppend != null
		{
			ClassAppends.Emplace(name,oldAppend,hash)
			oldData.UsedClassAppends.Insert(oldAppend)
			HotloadStream << "Kept old AppendClass " << name << "\n"
		}else{
			if oldData != null
			{
				cls := intGetClass2(name)->{BoxClassBody^}
				assert(cls != null)
				oldData.ctx.ReloadClasses.PushUniq(cls->{BoxClassBody^})
				cls.Appends.Emplace(this&,root)
				HotloadStream << "Added append to class " << name << "\n"
			}
				
			ClassAppends.Emplace(name,root,hash)
			classAppends[name].Push(root)
		}

	}
	ParseTypedefs := !(ReloadFileOldData^ oldData = null) -> void
	{
		if fileTokens == null
			return void

		LoadSpace()
		iter := fileTokens.Down
		while iter != null
		{
			if iter.Down?.Right?.Right?.GetValue() == "type"
			{
				if oldData != null
				{
					hsh := ComputeHash(iter)
					foundTypedef := TypedefTemplateVar^
					for it : oldData.Typedefs
					{
						if it.1 == hsh
						{
							foundTypedef = it.0
							break
						}
					}

					if foundTypedef != null
					{
						Typedefs.Emplace(foundTypedef,hsh)
						oldData.UsedTypedefs.Insert(foundTypedef)

						iter = iter.Right
						continue
					}
					
				}
				res := TryParseTypedefTemplate(iter)

				if res != null
				{
					assert(res is TypedefTemplateVar)
					asTemplate := res->{TypedefTemplateVar^}
					CurrentCodeSpace.Types[asTemplate.Name] = asTemplate
					ParsedTokens.Insert(iter)
				}
			}
			iter = iter.Right
		}
	}
	CreateFunc := !(Str newName,bool isSuffix,PFunctionParser^ newFunc,Token^ iter) -> void
	{
		fnc := newFunc.CreateObject()
		assert(fnc != null)
		assert(fnc is in BoxFuncTemplate)
		if fnc is in BoxFuncTemplateBody
		{
			fnc->{BoxFuncTemplateBody^}.headerHash = newFunc.ComputeHeaderHash()
			fnc->{BoxFuncTemplateBody^}.hash = newFunc.ComputeHash()
		}
		res := new TemplateFuncVar(newName,isSuffix,fnc->{BoxFuncTemplate^})

		ParsedTokens.Insert(iter?)
		res.MemObj.SetName(res.Name)
		CurrentCodeSpace.AddTemplate(res.Name,fnc->{BoxFuncTemplate^})

		Functions.Push(fnc->{BoxFuncTemplateBody^})
	}

	LoadSpace := !() -> void
	{
		CurrentFile = this&
		CurrentScope = this&
		foundSpace := false
		for spc : CodeSpaces
		{
			for fil : spc.Files
			{
				if fil == this&
				{
					CurrentCodeSpace = spc&
					foundSpace = true
					break
				}
			}
			if foundSpace
				break
		}
		assert(foundSpace)

	}


	
	state := CWorkParseFile^
	
	parsingIt := bool
	StartParseFile := !() -> void
	{
		if parsingIt
			return void

		state = new CWorkParseFile(this&)
		WorkBag.AddWork(state)

		parsingIt = true
		TSpawnTask(() ==> { //todo pass CurrentFile directly?
			ParseFile()

			state = null
			parsingIt = false
		})
	}
	
	ParseFile := !() -> void 
	{
		// LoadFiles()

		ParseBlock(null,fileTokens)
		state.itState = "Complete"
		loaded.Emit()
	}

	WorkingOnToken := Token^

	ParseBlock := !(ReloadFileOldData^ oldData, Token^ lst) -> void
	{
		if lst == null
			return void

		itr := lst.Down

		failedTokens := List.{Token^}

		state.itState = "Created"

		while itr != null
		{
			if not ParseRound(oldData,itr)
				failedTokens.Push(itr)
			itr = itr.Right
		}

		prevCounter := 0


		while failedTokens.Size() != 0
		{
			if prevCounter != failedTokens.Size()
			{
				HotloadStream << "MadeProgress\n"
				state.itState = "MadeProgress"
			}else{
				HotloadStream << "Failed\n"
				state.itState = "Failed"
			}
			prevCounter = failedTokens.Size()

			TaskYield()

			newFailedTokens := List.{Token^}

			for it : failedTokens
			{
				if not ParseRound(oldData,it)
					newFailedTokens.Push(it)
			}

			failedTokens.Destroy()
			failedTokens.start = newFailedTokens.start
			failedTokens.end = newFailedTokens.end
			failedTokens.itSize = newFailedTokens.itSize


			if state.itState == "Cancelled"
			{
				return void
			}

		}
	}

	ParseRound := !(ReloadFileOldData^ oldData, Token^ itr) -> bool
	{
		if itr == null
			return false

		WorkingOnToken = itr

		if itr.Down?.GetValue() == "AppendClass"
			return true

		// if itr.Down? is TokenIndent and itr.Down->{TokenIndent^}.Value == "#Module"
		// 	return true
		// if itr.Down? is TokenIndent and itr.Down->{TokenIndent^}.Value == "#CreateCallCommand"
		// 	return true

		LoadSpace()

		cmd := TryGetCommand(itr)
		if cmd != null
			return true

		if itr.Down?.Right?.GetValue() == ":="
		{
			name := Str
			nameObj := itr.Down
			isSuffix := false

			switch nameObj is
			{
			case TokenString
				name = nameObj.Value
				isSuffix = true
			case TokenIndent
				name = nameObj.Value
			case void
				assert(false)
			}

			right := nameObj.Right.Right

			cls := PClassParser(right)

			if cls.IsFound()
			{
				hash := cls.ComputeHash(fileData)
				if oldData != null
				{
					if not cls.IsTemplate() 
					{
						foundClass := BoxClassBody^

						for it : oldData.FileClasses
						{
							if it.Name == name
							{
								foundClass = it
								break
							}
						}

						if foundClass != null
						{
							dHsh := cls.ComputeHash(fileData)
							if foundClass.hash != dHsh
							{
								//TODO extends tokens
								foundClass.ParentTokens.Destroy()
								foundClass.Push(cls.parents[^])
								foundClass.Body = cls.bodyToken
								foundClass.hash = dHsh

								oldData.ctx.ReloadClasses.PushUniq(foundClass)
							}

							oldData.UsedFileClasses.Insert(foundClass)
							FileClasses.Push(foundClass)
							return true
						}

					}else{
						foundTemplate := BoxClassTemplateBody^

						for it : oldData.FileClassTemplates
						{
							if it.ItName == name
							{
								//TODO reload body
								foundTemplate = it
								break
							}
						}

						if foundTemplate != null
						{
							//TODO check change of hash
							oldData.UsedFileClassTemplates.Insert(foundTemplate)
							FileClassTemplates.Push(foundTemplate)
							return true
						}
					}
				}
				newObj := AddClass(name,cls&)

				switch newObj is
				{
				case BoxClassBody
					if classAppends.Contain(name)
					{
						newObj.Appends.Emplace(this&,classAppends[name][^])
					}
				}
				return true
			}
			fnc := PFunctionParser(right)

			if fnc.IsFound()
			{
				if oldData != null
				{
					hsh := fnc.ComputeHeaderHash()

					foundFunc := BoxFuncTemplateBody^
					for it : oldData.Functions
					{
						if it.GetHeaderHash() == hsh and name == it.Name
						{
							foundFunc = it
							break
						}
					}

					if foundFunc != null
					{
						if foundFunc.GetFullHash() != fnc.ComputeHash()
						{
							HotloadStream << "Function "<< foundFunc.Name << " changed its content\n"
							foundFunc.ReloadFunctions(oldData.ctx,fnc&,fileData)
						}

						Functions.Push(foundFunc)
						oldData.UsedFunctions.Insert(foundFunc)
						return true
					}
				}

				CreateFunc(name,isSuffix,fnc&,right)
				return true
			}

			if right.GetValue() == "task_local"
			{
				vr := new TaskLocalVarDelayed(name,right.Right)
				CurrentCodeSpace.Globals[name].Push(vr)

				return true
			}


			isRef := false
			isThreadLocal := false
			tpObj := right
			if tpObj.GetValue() == "thread_local"
			{
				tpObj = tpObj.Right
				isThreadLocal = true
			}

			if tpObj.GetValue() == "ref"
			{
				tpObj = tpObj.Right
				isRef = true
			}

			value := BoxExeConstObj^
			tp := ParseType(tpObj)

			if tp == null
			{
				value = TryGetExeCall(tpObj)->{BoxExeConstObj^}
				if value? is BoxArrayHolder
				{
					ah := value->{BoxArrayHolder^}
					// if ah.GetArraySize() == 0
					// {
					// 	CurrentWork?.SetErrorMessage(typeToken.MakeError("Can not use empty array as global variable"))
					// 	return void
					// }
					// if not ah.IsConst()
					// {
					// 	CurrentWork?.SetErrorMessage(typeToken.MakeError("Array must be made of constants"))
					// 	return void
					// }
					tp = ah.GetArrayType()
					value = ah.GetAsConst()
				}else{
					// if not (value? is in BoxExeConstObj)
					// {
					// 	CurrentWork?.SetErrorMessage(typeToken.MakeError("Global variable value must be a constant"))
					// 	return void
					// }
				}
				assert(tp != GTypeVoid)
				if value != null
					tp = value.GetType()

			}

			if tp != null
			{
				hash := ComputeHash(tpObj)


				if isRef
				{
					tp = tp.GetPoint()
				}

				if oldData != null
				{
					oldVar := GlobalVar2^
					for it, ind : oldData.GlobalVars
					{
						if it.ItName == name and it.GetType() == tp
						{
							oldVar = it
							break
						}
					}

					if oldVar != null
					{
						if oldVar.ItHash != hash
							oldVar = null
					}

					if oldVar != null
					{
						oldData.UsedGlobalVars.Insert(oldVar)
						itGlobalVars.Push(oldVar)
						HotloadStream << "Kept var " << name << "\n" 
						return true
					}else {
						HotloadStream << "Adding new global variable " << name << "\n"
					}
				}
				

				vr := new GlobalVar2(name,tp,isThreadLocal)
				vr.isReference = isRef
				vr.value = value
				vr.ItHash = hash
				GlobalVars2.Push(vr)
				itGlobalVars.Push(vr)
				CurrentCodeSpace.Globals[name].Push(vr)
				// vr.CheckValue()

				return true
			}

			if right.GetValue() == "type"
			{
				hash := ComputeHash(itr)

				if oldData != null
				{
					oldDef := TypedefTemplateVar^

					for df : oldData.Typedefs
					{
						if df.Name == name
						{
							oldDef = df
						}
					}

					if oldDef?.Value.ItHash != hash
						oldDef = null

					if oldDef != null
					{
						Typedefs.Push(oldDef)
						oldData.UsedTypedefs.Insert(oldDef)
						HotloadStream << "Kept old typedef " << name << "\n"
						return true
					}
				}
			
				res := TryParseTypedefTemplate(itr)

				if res != null
				{
					Typedefs.Push(res)
					CurrentCodeSpace.Types[name] = res
					return true
				}
			}

			if right.Down?.GetValue() == "enum"
			{
				hash := ComputeHash(right)

				if oldData != null
				{
					foundEnum := BoxEnum^
					foundVr := TypeVar^

					for it,ind : oldData.Enums
					{
						if ind != name
							continue
						if it.2 != hash
							continue
						foundEnum = it.0
						foundVr := it.1

						break
					}

					if foundEnum != null
					{
						entry := ref FileEnums[name]
						entry.0 = foundEnum
						entry.1 = foundVr
						entry.2 = hash

						oldData.UsedEnums.Insert(foundEnum)

						HotloadStream << "Kept enum " << name << "\n"
					}

				}

				en := TryParseEnum(right)
				assert(en != null)
				vr := new TypeVar(name,en.ItType)
				CurrentCodeSpace.Globals[name].Push(vr)
				CurrentCodeSpace.Types[name] = en.ItType

				assert(en.ItType != null)

				entry := ref FileEnums[name]
				entry.0 = en
				entry.1 = vr
				entry.2 = hash
				return true
			}

			// printf("failed %s\n",name)
		}
		return false
	}
	PrintCode := virtual !(LLVMWriteContext^ ctx) -> void
	{
		if DebugMode //later
		{
			f := ctx.writeStream
			pth := file.GetPath()
			if fsIsExist(pth.Str())
			{
				pth2 := fsGetAbsolutePath(pth)
				if not pth2.IsSet()
					pth2 = pth
				p := pth2.GetOr("")
				f^ << "!" << fileId  << " = !DIFile(filename: \"" 
				f^ << p.Str() << "\", directory: \""
				f^ <<  "/" <<"\")\n"
			}else{
				f^ << "!" << fileId  << " = !DIFile(filename: \"" 
				f^ << file.GetName() << "\", directory: \""
				f^ <<  "/" <<"\")\n"
			}
		}
	}
}
TryParseVarInFile := !(Token^ obj) -> BoxUnit^
{
	if obj == null or obj.Down == null
		return null

	iter := obj.Down

	if iter.Right == null
		return null
	if iter.Right?.GetValue() != ":="
		return null

	name := StringSpan
	if iter is TokenIndent
	{
		name = iter->{TokenIndent^}.Value
	}else if iter is TokenString
	{
		name = StringSpan(iter->{TokenString^}.Value.Str())
	}

	varToken := iter.Right.Right

	if varToken == null
		return null

	if varToken.Down?.GetValue() == "enum"
	{
		en := TryParseEnum(varToken)
		assert(en != null)
		return new TypeVar(name,en.ItType)
	}
	
	if varToken.GetValue() == "thread_local"
	{
		return null
	}
	
	if varToken.GetValue() == "task_local"
	{
		return new TaskLocalVarDelayed(name,varToken.Right)
	}

	return null
}


CWorkParseFile := class extend CWorkUnit
{
	itFile := BoxFile^
	itError := Str
	itState := CWorkState

	this := !(BoxFile^ inpFile) -> void
	{
		itFile = inpFile
		itState = "Created"
	}
	GetErrorMessage := virtual !() -> Str
	{
		return itError
	}
	IsDone :=  virtual !() -> bool {
		if itFile.state != this&
			return true
		return itState == "Complete" or itState == "Cancelled"
	}
	DoWork := virtual !() -> CWorkState
	{
		// printf("hey %s\n",itState.ToCStr())
		return itState
	}
	Cancel := virtual !() -> void
	{
		itState = "Cancelled"
	}
}

TryParseBlockInFile := !(Token^ it) -> BoxExeObj^
{
	return TryParseIf(it,true)?
}
	classAppends := List.{Token^}[Str]
