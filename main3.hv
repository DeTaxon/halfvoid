



main := !(char^[] args) -> int
{
	printf("-------------\n")

	a := Class1
	b := Class2
	c := Class3
	d := Class4

	printf("Test %s\n",a.Test)
	printf("Test %s\n",b.Test)
	printf("Test %s\n",c.Test)
	printf("Test %s\n",d.Test)

	CallVirtual(![a&,b&,c&,d&])
}


CallVirtual := !(Class1^[] objs) -> void
{
	printf("hmm %s\n",objs[^].Test)
}


Class1 := class
{
	x := int
	y := int

	Test := poison virtual #ThisClass()->TypeName
}

Class2 := class extends Class1
{
	z := double
	// Gifting := !() -> void
	// {
	// 	printf("end\n")
	// }
}

Class3 := class extends Class2
{
	w := double
	zz := int
	// Gifting := !() -> void
	// {
	// 	printf("end1\n")
	// }
}

Class4 := class extends Class3
{
	extraSize := int
}

