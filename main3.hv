



main := !(char^[] args) -> int
{
	printf("-------------\n")

	a := Class1
	b := Class2
	
	Test(a&)
	Test(b&)
}


Test := !(Class1^ a) -> void
{
	printf("Test %s\n",a.Test)
	// printf("natbe %i %p\n",a is in Class1,a)
	
}


Class1 := class
{
	x := int
	y := int
	
	Test := poison virtual #ThisClass()->TypeName
	// Hm := virtual !() -> void {}

}

Class2 := class extends Class1
{
	z := double
}


